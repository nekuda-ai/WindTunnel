diff --git a/Dockerfile.all-in-one b/Dockerfile.all-in-one
index 45b18a5..c3d4dcf 100644
--- a/Dockerfile.all-in-one
+++ b/Dockerfile.all-in-one
@@ -1,8 +1,10 @@
-FROM node:22-alpine AS node-frontend
+ARG WEBMCP_NODE_BUILDER=node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
+ARG WEBMCP_PHP_RUNTIME=serversideup/php:8.3-fpm-alpine-v3.4.5@sha256:f9b8c621cf0cbcd2769fab78c24db0afea04d8b043a64474458d08ec736d29fc
+FROM ${WEBMCP_NODE_BUILDER} AS node-frontend

 WORKDIR /app/frontend

-RUN apk add --no-cache yarn
+RUN corepack enable && corepack prepare yarn@1.22.22 --activate

 # Increase network timeout for slow ARM emulation builds
 RUN yarn config set network-timeout 600000
@@ -15,7 +17,7 @@ COPY ./VERSION /app/VERSION
 RUN yarn install --network-timeout 600000 --frozen-lockfile && yarn build

 # Use stable multi-arch serversideup/php image
-FROM serversideup/php:8.3-fpm-alpine
+FROM ${WEBMCP_PHP_RUNTIME}

 ENV PHP_OPCACHE_ENABLE=1

@@ -27,7 +29,14 @@ RUN install-php-extensions intl
 RUN apk add --no-cache nodejs yarn nginx supervisor dos2unix
+# The all-in-one image switches to root for its build and does not switch back.
+# Keep FPM workers on the base image's unprivileged application identity.
+RUN sed -i -e 's/^;user = www-data/user = www-data/' -e 's/^;group = www-data/group = www-data/' /usr/local/etc/php-fpm.d/docker-php-serversideup-pool.conf

 COPY --from=node-frontend /app/frontend /app/frontend

+# The pinned build stage is Debian/glibc while the runtime is Alpine/musl.
+# Re-resolve runtime dependencies so native optional packages match Alpine.
+RUN rm -rf /app/frontend/node_modules && yarn --cwd /app/frontend install --network-timeout 600000 --frozen-lockfile
+
 COPY ./backend /app/backend
 COPY ./VERSION /app/backend/VERSION
 RUN mkdir -p /app/backend/bootstrap/cache \
