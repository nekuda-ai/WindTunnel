+import { useEffect } from 'react';
+
+// WebMCP (navigator.modelContext) integration.
+// Spec draft: https://github.com/webmachinelearning/webmcp
+//
+// Tools are registered per document. In this SPA we tie registrations to
+// component lifecycles: register in an effect, unregister by aborting the
+// registration's AbortSignal on unmount or when the tool changes (e.g. the
+// user logs out). No-ops in browsers without WebMCP support.
+
+export type WebMCPToolResult = {
+  content: Array<{ type: 'text'; text: string }>;
+};
+
+export type WebMCPTool = {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations?: {
+    readOnlyHint?: boolean;
+    untrustedContentHint?: boolean;
+  };
+  execute: (args: any) => Promise<WebMCPToolResult>;
+};
+
+type ModelContext = {
+  registerTool: (
+    tool: WebMCPTool,
+    options?: { signal?: AbortSignal },
+  ) => Promise<void>;
+};
+
+// document.modelContext is the spec surface; navigator.modelContext is the
+// deprecated alias (warns in newer Chromium builds).
+const getModelContext = (): ModelContext | undefined => {
+  if (typeof document === 'undefined') return undefined;
+  return (
+    (document as Document & { modelContext?: ModelContext }).modelContext ??
+    (navigator as Navigator & { modelContext?: ModelContext }).modelContext
+  );
+};
+
+export const textResult = (payload: unknown): WebMCPToolResult => ({
+  content: [
+    {
+      type: 'text',
+      text:
+        typeof payload === 'string' ? payload : JSON.stringify(payload, null, 2),
+    },
+  ],
+});
+
+// Registers `tool` while the calling component is mounted; pass null to keep
+// it unregistered (e.g. while its auth requirement is unmet).
+export const useWebMCPTool = (tool: WebMCPTool | null) => {
+  useEffect(() => {
+    const modelContext = getModelContext();
+    if (!tool || typeof modelContext?.registerTool !== 'function') return;
+
+    const controller = new AbortController();
+    Promise.resolve(
+      modelContext.registerTool(tool, { signal: controller.signal }),
+    ).catch((error) => {
+      // Rejections from an already-aborted signal are expected on fast
+      // unmount/remount cycles; anything else is worth surfacing.
+      if (!controller.signal.aborted) {
+        console.warn(`WebMCP: failed to register tool "${tool.name}"`, error);
+      }
+    });
+
+    return () => controller.abort();
+  }, [tool]);
+};
