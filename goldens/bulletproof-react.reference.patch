+// Build-time content bundle backing the `ask_site` WebMCP tool: the app's own
+// pages and copy, keyword-matched client-side. The calling agent composes the
+// final answer from the returned sections — no backend or AI infra needed.
+
+export type SiteContentSection = {
+  title: string;
+  path: string;
+  content: string;
+};
+
+export const siteContent: SiteContentSection[] = [
+  {
+    title: 'About Bulletproof React',
+    path: '/',
+    content:
+      'Bulletproof React showcases best practices for building React applications. ' +
+      'This demo is a team discussions app: create an account for your team, then ' +
+      'read and take part in team-scoped discussion threads with comments. Use ' +
+      '"Get started" on the landing page to sign in. Source code: ' +
+      'https://github.com/alan2207/bulletproof-react.',
+  },
+  {
+    title: 'Creating an account and signing in',
+    path: '/auth/register',
+    content:
+      'Register with first name, last name, email and a password (minimum 5 ' +
+      'characters). Pick one of two team options: enter a Team Name to create a ' +
+      "new team — you become that team's ADMIN — or toggle \"Join Existing Team\" " +
+      'and select a team to join as a regular USER (member). Existing accounts ' +
+      'log in with email and password at /auth/login. Signing in is required for ' +
+      'the app area: dashboard, discussions and comments.',
+  },
+  {
+    title: 'Roles and permissions',
+    path: '/app',
+    content:
+      'Two roles exist. USER (regular member): create comments in discussions ' +
+      'and delete their own comments. ADMIN: create, edit and delete ' +
+      "discussions, comment, delete any comment, and view the team's users " +
+      'list. Your role is shown on the dashboard after signing in.',
+  },
+  {
+    title: 'Discussions and comments',
+    path: '/app/discussions',
+    content:
+      'Discussions are threads visible only to your team, listed at ' +
+      '/app/discussions with title, author and creation date (10 per page). ' +
+      'Open a discussion to read its body (markdown) and comments, and to add ' +
+      'your own comment. Discussions themselves are created and edited by team ' +
+      'admins.',
+  },
+  {
+    title: 'Your profile and team',
+    path: '/app/profile',
+    content:
+      'The profile page shows your first name, last name, email and bio. The ' +
+      "users page at /app/users lists the team's members and is visible to " +
+      'admins only.',
+  },
+];
+
+const tokenize = (value: string) =>
+  value
+    .toLowerCase()
+    .split(/[^a-z0-9]+/)
+    .filter((token) => token.length > 2);
+
+// Tiny client-side keyword retrieval over the bundle. Returns ONLY sections
+// that actually match — an empty result means the site's content does not
+// answer the query, and the tool reports that honestly instead of dumping
+// unrelated grounding.
+export const searchSiteContent = (
+  query: string,
+  limit = 3,
+): SiteContentSection[] => {
+  const terms = [...new Set(tokenize(query))];
+  const scored = siteContent.map((section) => {
+    const haystack = `${section.title} ${section.content}`.toLowerCase();
+    return {
+      section,
+      score: terms.filter((term) => haystack.includes(term)).length,
+    };
+  });
+  const matches = scored.filter(({ score }) => score > 0);
+  return matches
+    .sort((a, b) => b.score - a.score)
+    .slice(0, limit)
+    .map(({ section }) => section);
+};
+
+// Section titles, for the honest no-match response ("here is what the site
+// does cover").
+export const siteContentTopics = (): string[] =>
+  siteContent.map((section) => section.title);
