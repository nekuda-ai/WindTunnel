@@ -0,0 +1,609 @@
+// WebMCP tool definitions for IDURAR ERP CRM.
+//
+// Tools answer what a person working their books beside a browser agent
+// actually asks: "find client X", "what's still unpaid?", "draft an invoice
+// for Acme", "record their wire payment". Every working tool's execute() rides
+// the app's own authenticated request layer (@/request — axios + the session
+// JWT), so no working tool handles credentials, and state-changing tools
+// navigate the UI to the affected record so the user sees the result.
+//
+// sign_in is the one deliberate exception: the CRM tools do not exist until the
+// workspace is authenticated, so an agent driving this site purely through
+// WebMCP has no way in. It takes the credentials the user hands it and passes
+// them straight to the app's own login action — the same path the sign-in form
+// uses — and stores nothing itself.
+//
+// Registration is auth-conditioned in WebMcp.jsx: ask_site is always on;
+// logged out, sign_in plus a guidance-stage create_invoice are exposed; the
+// full CRM set registers on login and is aborted (unregistered) on logout.
+
+import { request } from '@/request';
+import { erp } from '@/redux/erp/actions';
+import { login } from '@/redux/auth/actions';
+import { settingsAction } from '@/redux/settings/actions';
+import { searchContent, CONTENT_TOPICS } from './content';
+
+// Navigate to an invoice and refresh the read view (covers the case where the
+// page is already showing that invoice — same-URL navigation would not refetch).
+const showInvoice = ({ navigate, dispatch }, id) => {
+  navigate(`/invoice/read/${id}`);
+  dispatch(erp.read({ entity: 'invoice', id }));
+};
+
+const textResult = (payload) => ({
+  content: [{ type: 'text', text: JSON.stringify(payload, null, 2) }],
+});
+
+const failure = (error, extra = {}) => textResult({ success: false, error, ...extra });
+
+const isObjectId = (s) => typeof s === 'string' && /^[0-9a-fA-F]{24}$/.test(s);
+
+const round2 = (n) => Math.round(n * 100) / 100;
+
+const isoDate = (value, fallback) => {
+  const d = value ? new Date(value) : fallback;
+  return Number.isNaN(d.getTime()) ? null : d;
+};
+
+const outstanding = (inv) => round2((inv.total || 0) - (inv.discount || 0) - (inv.credit || 0));
+
+const invoiceSummaryRow = (inv) => ({
+  id: inv._id,
+  number: inv.number,
+  year: inv.year,
+  client: inv.client?.name || inv.client,
+  date: inv.date,
+  due_date: inv.expiredDate,
+  total: inv.total,
+  paid: inv.credit || 0,
+  balance: outstanding(inv),
+  status: inv.status,
+  payment_status: inv.paymentStatus,
+  items: (inv.items || []).map((it) => ({
+    name: it.itemName || it.name,
+    quantity: it.quantity,
+    price: it.price,
+    total: it.total,
+  })),
+});
+
+async function resolveClient(ref) {
+  if (isObjectId(ref)) {
+    const res = await request.read({ entity: 'client', id: ref });
+    if (res?.success && res.result) return { client: res.result };
+    return { error: `No client found with id ${ref}.` };
+  }
+  const res = await request.search({ entity: 'client', options: { q: ref, fields: 'name,email' } });
+  const matches = res?.success && Array.isArray(res.result) ? res.result : [];
+  if (matches.length === 0) {
+    return { error: `No client matches "${ref}". Use find_clients to look up existing clients.` };
+  }
+  const exact = matches.find((c) => c.name?.toLowerCase() === String(ref).toLowerCase());
+  if (exact) return { client: exact };
+  if (matches.length === 1) return { client: matches[0] };
+  return {
+    error: `Multiple clients match "${ref}": ${matches
+      .map((c) => c.name)
+      .join(', ')}. Use the exact name or the client id.`,
+  };
+}
+
+// Resolve an invoice reference to exactly one invoice, or refuse. Accepts a
+// 24-char object id (preferred — always unique), a bare invoice number, or a
+// "number/year" form. Invoice numbers are NOT globally unique (they can repeat
+// across years, or be edited by hand), so a bare number that matches more than
+// one invoice is rejected with the candidates rather than silently guessing —
+// this feeds record_payment, and picking the wrong invoice would misapply a
+// payment. Parsing is strict: "2abc" is rejected, not read as 2.
+async function resolveInvoice(ref) {
+  const raw = String(ref ?? '').trim();
+  if (isObjectId(raw)) {
+    const res = await request.read({ entity: 'invoice', id: raw });
+    if (res?.success && res.result) return { invoice: res.result };
+    return { error: `No invoice found with id ${raw}.` };
+  }
+  const parsed = raw.match(/^(\d+)(?:\s*\/\s*(\d+))?$/);
+  if (!parsed) {
+    return {
+      error: `"${ref}" is not a valid invoice reference. Use an invoice id, a number (e.g. "42"), or number/year (e.g. "42/2026").`,
+    };
+  }
+  const number = parseInt(parsed[1], 10);
+  const year = parsed[2] ? parseInt(parsed[2], 10) : null;
+  const res = await request.list({
+    entity: 'invoice',
+    options: { filter: 'number', equal: number, items: 50 },
+  });
+  let matches = res?.success && Array.isArray(res.result) ? res.result : [];
+  // Re-filter client-side: the list endpoint matches broadly, so pin to the
+  // exact number (and year when given) before deciding uniqueness.
+  matches = matches.filter((inv) => inv.number === number);
+  if (year != null) matches = matches.filter((inv) => inv.year === year);
+  if (matches.length === 0) {
+    return {
+      error:
+        year != null
+          ? `No invoice #${number}/${year} found. Use list_invoices to see existing invoices.`
+          : `No invoice with number ${number} found. Use list_invoices to see existing invoices.`,
+    };
+  }
+  if (matches.length > 1) {
+    const candidates = matches
+      .map((inv) => `#${inv.number}/${inv.year} (id ${inv._id})`)
+      .join(', ');
+    return {
+      error: `Invoice number ${number} is ambiguous — it matches ${matches.length} invoices: ${candidates}. Re-run with number/year (e.g. "${number}/${matches[0].year}") or the invoice id.`,
+    };
+  }
+  return { invoice: matches[0] };
+}
+
+const askSiteTool = {
+  name: 'ask_site',
+  description:
+    'Answer questions about the IDURAR ERP CRM app itself from its own pages and docs: what the product is, its modules (dashboard, customers, invoices, payments, settings), how invoicing and payment recording work, how to sign in, licensing/pricing. Read-only; returns the most relevant content sections with their source pages so you can compose an answer. It does NOT read business records — after signing in, use find_clients / list_invoices for that.',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      query: { type: 'string', description: 'The visitor question or keywords.' },
+    },
+    required: ['query'],
+  },
+  annotations: { readOnlyHint: true },
