+};
+
+// Two-stage conversion entry: this registration exists only while signed out.
+const buildCreateInvoiceEntryTool = ({ navigate }) => ({
+  name: 'create_invoice',
+  description:
+    'Create a new invoice for a client in this IDURAR workspace. Signing in is required first: while signed out, calling this opens the sign-in page and returns guidance instead of creating anything. After the user signs in, this tool is replaced by the fully functional version.',
+  inputSchema: { type: 'object', properties: {} },
+  annotations: { readOnlyHint: true },
+  async execute() {
+    navigate('/login');
+    return textResult({
+      success: false,
+      error: 'Not signed in.',
+      guidance:
+        'Creating invoices requires an authenticated session. The sign-in page is now open — ask the user to sign in with their workspace account; the full create_invoice tool (plus client, invoice and payment tools) registers right after login.',
+    });
+  },
+});
+
+const buildCreateInvoiceTool = (ui) => ({
+  name: 'create_invoice',
+  description:
+    'Create a real invoice for an existing client in this workspace. Give the client name (as stored in Customers) or client id, plus line items with quantity and unit price; the server computes totals and the next invoice number is assigned automatically. This saves a new invoice record and navigates the page to it so the user sees the result. Returns the created invoice id, number, totals and payment status. Use find_clients first if unsure of the exact client name.',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      client: {
+        type: 'string',
+        description: 'Client name exactly as stored in Customers, or a client id.',
+      },
+      items: {
+        type: 'array',
+        minItems: 1,
+        description: 'Invoice line items.',
+        items: {
+          type: 'object',
+          properties: {
+            name: { type: 'string', description: 'Item or service name.' },
+            description: { type: 'string' },
+            quantity: {
+              type: 'number',
+              exclusiveMinimum: 0,
+              description: 'Must be greater than 0.',
+            },
+            price: { type: 'number', minimum: 0, description: 'Unit price (0 or more).' },
+          },
+          required: ['name', 'quantity', 'price'],
+        },
+      },
+      status: {
+        type: 'string',
+        enum: ['draft', 'pending', 'sent'],
+        description: 'Workflow status. Default: draft.',
+      },
+      date: { type: 'string', description: 'Invoice date (YYYY-MM-DD). Default: today.' },
+      expired_date: {
+        type: 'string',
+        description: 'Due date (YYYY-MM-DD). Default: 30 days after the invoice date.',
+      },
+      tax_rate: {
+        type: 'number',
+        minimum: 0,
+        maximum: 100,
+        description: 'Tax rate in percent (0–100). Default: 0.',
+      },
+      notes: { type: 'string' },
+    },
+    required: ['client', 'items'],
+  },
+  annotations: { readOnlyHint: false, untrustedContentHint: true },
+  async execute({ client, items, status = 'draft', date, expired_date, tax_rate = 0, notes = '' }) {
+    const resolved = await resolveClient(client);
+    if (resolved.error) return failure(resolved.error);
+
+    if (!Array.isArray(items) || items.length === 0) {
+      return failure('At least one line item (name, quantity, price) is required.');
+    }
+    // Guard numeric inputs before sending: the server trusts these amounts for
+    // totals, so reject non-positive quantities, negative prices and out-of-range
+    // tax rates rather than persisting a nonsensical invoice.
+    for (const [i, it] of items.entries()) {
+      if (!(Number(it.quantity) > 0)) {
+        return failure(`Line item ${i + 1} ("${it.name ?? ''}") needs a quantity greater than 0.`);
+      }
+      if (!(Number(it.price) >= 0)) {
+        return failure(`Line item ${i + 1} ("${it.name ?? ''}") needs a price of 0 or more.`);
+      }
+    }
+    if (!(Number(tax_rate) >= 0 && Number(tax_rate) <= 100)) {
+      return failure('tax_rate must be between 0 and 100 (percent).');
+    }
+    const invoiceDate = isoDate(date, new Date());
+    if (!invoiceDate) return failure(`Invalid date: "${date}".`);
+    const dueDate = isoDate(expired_date, new Date(invoiceDate.getTime() + 30 * 24 * 3600 * 1000));
+    if (!dueDate) return failure(`Invalid expired_date: "${expired_date}".`);
+
+    // Number is NOT sent: the server allocates it atomically from the finance
+    // counter (see invoiceController/create.js), so concurrent creates can't
+    // collide. Derive year in UTC to match the ISO date we send — a local
+    // getFullYear() near New Year in a negative-offset zone could disagree with
+    // the stored date's year.
+    const jsonData = {
+      client: resolved.client._id,
+      year: invoiceDate.getUTCFullYear(),
+      status,
+      notes,
+      date: invoiceDate.toISOString(),
+      expiredDate: dueDate.toISOString(),
+      taxRate: tax_rate,
+      items: items.map((it) => ({
+        itemName: it.name,
+        description: it.description || '',
+        quantity: it.quantity,
+        price: it.price,
+        total: round2(it.quantity * it.price),
+      })),
+    };
+    const res = await request.create({ entity: 'invoice', jsonData });
+    if (!res?.success || !res.result) {
+      return failure(res?.message || 'Invoice creation failed.');
+    }
+    const inv = res.result;
+    // The server bumped last_invoice_number during allocation; refresh the
+    // settings store so the UI's own create form (which prefills from it)
+    // suggests the next free number instead of colliding with this one.
+    ui.dispatch(settingsAction.list({ entity: 'setting' }));
+    showInvoice(ui, inv._id);
+    return textResult({
+      success: true,
+      invoice: { ...invoiceSummaryRow(inv), client: resolved.client.name },
+      ui: 'The created invoice is now open on the page.',
+    });
+  },
+});
+
+const findClientsTool = {
+  name: 'find_clients',
+  description:
+    "Search this workspace's customer records by name or email (case-insensitive substring). Read-only. Returns up to 20 matching clients with id, name, email, phone and country — use the id or exact name with create_invoice, list_invoices or record_payment.",
+  inputSchema: {
+    type: 'object',
+    properties: {
+      query: { type: 'string', description: 'Part of the client name or email.' },
+    },
+    required: ['query'],
+  },
+  annotations: { readOnlyHint: true, untrustedContentHint: true },
+  async execute({ query }) {
+    const res = await request.search({
+      entity: 'client',
+      options: { q: String(query ?? ''), fields: 'name,email' },
+    });
+    const matches = res?.success && Array.isArray(res.result) ? res.result : [];
+    if (matches.length === 0) {
+      return textResult({
+        success: true,
+        clients: [],
+        note: `No clients match "${query}".`,
+      });
+    }
+    return textResult({
+      success: true,
+      clients: matches.map((c) => ({
+        id: c._id,
+        name: c.name,
+        email: c.email,
+        phone: c.phone,
+        country: c.country,
+      })),
+    });
+  },
+};
+
+const listInvoicesTool = {
+  name: 'list_invoices',
+  description:
+    "List this workspace's invoices, optionally filtered by payment status (by payment state), workflow status (draft, pending, sent, refunded, cancelled, on hold) and/or client name. Read-only; searches the most recent ~100 invoices. Returns per invoice: number, client, dates, total, amount paid, outstanding balance, statuses, id, and its line items (name, quantity, price). Use it to look up invoices and their line items.",
+  inputSchema: {
+    type: 'object',
+    properties: {
+      payment_status: {
+        type: 'string',
+        enum: ['unpaid', 'partially', 'paid'],
+        description: 'Only invoices with this payment status.',
+      },
+      status: {
+        type: 'string',
+        enum: ['draft', 'pending', 'sent', 'refunded', 'cancelled', 'on hold'],
+        description: 'Only invoices with this workflow status.',
+      },
+      client: { type: 'string', description: 'Only invoices for this client (name or id).' },
+      limit: { type: 'number', description: 'Max rows to return. Default 20.' },
+    },
+  },
+  annotations: { readOnlyHint: true, untrustedContentHint: true },
+  async execute({ payment_status, status, client, limit = 20 } = {}) {
+    // Ask the server for newest-first order (by creation time) so the 100-row
+    // window genuinely holds the most recent invoices. The endpoint's default
+    // sort is a non-existent `enabled` field (arbitrary order), which would let
+    // the window miss recent invoices once there are more than 100. Sort value
+    // must be a word the API accepts ('desc') — query params arrive as strings
+    // and Mongoose rejects a bare "-1".
+    const options = { items: 100, sortBy: 'created', sortValue: 'desc' };
+    let clientName = null;
+    if (client) {
+      const resolved = await resolveClient(client);
+      if (resolved.error) return failure(resolved.error);
+      clientName = resolved.client.name;
+      options.filter = 'client';
+      options.equal = resolved.client._id;
+    } else if (payment_status) {
+      options.filter = 'paymentStatus';
+      options.equal = payment_status;
+    } else if (status) {
+      options.filter = 'status';
+      options.equal = status;
+    }
+    const res = await request.list({ entity: 'invoice', options });
+    let rows = res?.success && Array.isArray(res.result) ? res.result : [];
+    if (payment_status) rows = rows.filter((r) => r.paymentStatus === payment_status);
+    if (status) rows = rows.filter((r) => r.status === status);
+    rows.sort((a, b) => new Date(b.created) - new Date(a.created));
+    rows = rows.slice(0, Math.max(1, limit));
+    if (rows.length === 0) {
+      return textResult({
+        success: true,
+        invoices: [],
+        note: 'No invoices match these filters.',
+        filters: { payment_status, status, client: clientName || client },
+      });
+    }
+    return textResult({
+      success: true,
+      count: rows.length,
+      invoices: rows.map(invoiceSummaryRow),
+    });
+  },
+};
+
+const buildRecordPaymentTool = (ui) => ({
+  name: 'record_payment',
+  description:
+    "Record a payment received against an existing invoice, by invoice number or id. This writes a real payment record and updates the invoice's paid amount and payment status (unpaid → partially → paid); an amount above the outstanding balance is rejected. Navigates the page to the updated invoice so the user sees the new status. Returns the payment id plus the invoice's updated balance and payment status.",
+  inputSchema: {
+    type: 'object',
+    properties: {
+      invoice: {
+        type: 'string',
+        description:
+          'Invoice id, number (e.g. "42"), or number/year (e.g. "42/2026"). If a bare number matches more than one invoice, the call is rejected — pass number/year or the id.',
+      },
+      amount: {
+        type: 'number',
+        exclusiveMinimum: 0,
+        description: 'Payment amount received (> 0).',
+      },
+      date: { type: 'string', description: 'Payment date (YYYY-MM-DD). Default: today.' },
+      ref: { type: 'string', description: 'Payment reference, e.g. a wire or check number.' },
+      description: { type: 'string' },
+    },
+    required: ['invoice', 'amount'],
+  },
+  annotations: { readOnlyHint: false, untrustedContentHint: true },
+  async execute({ invoice, amount, date, ref = '', description = '' }) {
+    const resolved = await resolveInvoice(invoice);
+    if (resolved.error) return failure(resolved.error);
+    const inv = resolved.invoice;
+    const balance = outstanding(inv);
+    if (!(amount > 0)) return failure('The payment amount must be greater than 0.');
+    // Fast, friendly pre-check against the balance we just read. This is
+    // advisory only: the authoritative no-overpay guard is server-side — the
+    // payment endpoint increments credit with an atomic balance predicate, so
+    // even two concurrent record_payment calls can never overpay (the loser is
+    // rejected). The number is allocated server-side too, so none is sent here.
+    if (amount > balance) {
+      return failure(
+        `Invoice #${inv.number}/${inv.year} has an outstanding balance of ${balance} — cannot record ${amount}.`,
+        { invoice: invoiceSummaryRow(inv) }
+      );
+    }
+    const paymentDate = isoDate(date, new Date());
+    if (!paymentDate) return failure(`Invalid date: "${date}".`);
+
+    const res = await request.create({
+      entity: 'payment',
+      jsonData: {
+        client: inv.client?._id || inv.client,
+        invoice: inv._id,
+        date: paymentDate.toISOString(),
+        amount,
+        ref,
+        description,
+      },
+    });
+    if (!res?.success || !res.result) {
+      return failure(res?.message || 'Payment could not be recorded.');
+    }
+    showInvoice(ui, inv._id);
+    // Re-read the invoice so we report its REAL post-payment balance/status.
+    // Retry once; if the refresh still fails, say so rather than echoing the
+    // pre-payment snapshot as if it were updated.
+    let refreshed = null;
+    for (let attempt = 0; attempt < 2 && !refreshed; attempt += 1) {
+      const updated = await request.read({ entity: 'invoice', id: inv._id });
+      if (updated?.success && updated.result) refreshed = updated.result;
+    }
+    if (!refreshed) {
+      return textResult({
+        success: true,
+        payment: { id: res.result._id, number: res.result.number, amount, ref },
+        invoice: null,
+        warning:
+          'Payment was recorded, but the updated invoice could not be reloaded — open the invoice (now on screen) to see its current balance and status.',
+        ui: 'The invoice page is now open.',
+      });
+    }
+    return textResult({
+      success: true,
+      payment: { id: res.result._id, number: res.result.number, amount, ref },
+      invoice: invoiceSummaryRow(refreshed),
+      ui: 'The updated invoice is now open on the page.',
+    });
+  },
+});
+
+const financialSummaryTool = {
+  name: 'get_financial_summary',
+  description:
+    "Read-only snapshot of this workspace's finances for a period (week, month or year; default month): total invoiced, amount still due, invoice status breakdown, payments received, and client activity — the same numbers as the dashboard. Use it for finance questions.",
+  inputSchema: {
+    type: 'object',
+    properties: {
+      period: { type: 'string', enum: ['week', 'month', 'year'], description: 'Default: month.' },
+    },
+  },
+  annotations: { readOnlyHint: true },
+  async execute({ period = 'month' } = {}) {
+    const [inv, pay, cli] = await Promise.all([
+      request.summary({ entity: 'invoice', options: { type: period } }),
+      request.summary({ entity: 'payment', options: { type: period } }),
+      request.summary({ entity: 'client' }),
+    ]);
+    const failedSections = [
+      !inv?.success && 'invoices',
+      !pay?.success && 'payments_received',
+      !cli?.success && 'clients',
+    ].filter(Boolean);
+    return textResult({
+      success: failedSections.length === 0,
+      ...(failedSections.length
+        ? {
+            partial: true,
+            failed_sections: failedSections,
+            note: 'The failed sections are unavailable right now.',
+          }
+        : {}),
+      period,
+      invoices: inv?.success
+        ? {
+            invoiced_total: inv.result.total,
+            amount_due: inv.result.total_undue,
+            status_breakdown: inv.result.performance,
+          }
+        : null,
+      payments_received: pay?.success ? pay.result : null,
+      clients: cli?.success ? cli.result : null,
+    });
+  },
+};
+
+// Signed out, every CRM tool is unregistered, so an agent working through
+// WebMCP alone cannot reach the workspace at all — there is nothing to call and
+// no form it can fill. sign_in is the way in: it hands the caller's credentials
+// to the app's own login action (@/redux/auth/actions), which authenticates via
+// the same endpoint the sign-in form posts to and persists the session exactly
+// as a human sign-in would. The auth-state effect in WebMcp.jsx then swaps the
+// anonymous set for the full CRM set. The tool keeps no copy of the password.
+//
+// The login action reports its outcome only through store + persisted state, so
+// success is confirmed by reading back the auth state it writes.
+const readAuthState = () => {
+  try {
+    return JSON.parse(window.localStorage.getItem('auth') || '{}');
+  } catch {
+    return {};
+  }
+};
+
+const buildSignInTool = (ui) => ({
+  name: 'sign_in',
+  description:
+    'Sign in to this workspace with an email and password. Required first: while signed out the client, invoice and payment tools are not registered at all, so nothing else here will work. On success the full set (find_clients, list_invoices, create_invoice, record_payment, get_financial_summary) becomes available immediately — call list_site_tools again to see it.',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      email: { type: 'string', description: 'Account email address.' },
+      password: { type: 'string', description: 'Account password.' },
+    },
+    required: ['email', 'password'],
+  },
+  async execute({ email, password } = {}) {
+    if (!email || !password) {
+      return failure('Both email and password are required to sign in.');
+    }
+    if (readAuthState().isLoggedIn === true) {
+      return textResult({
+        success: true,
+        already_signed_in: true,
+        note: 'This workspace is already signed in; the full CRM tool set is registered.',
+      });
+    }
+    try {
+      await ui.dispatch(login({ loginData: { email, password } }));
+    } catch (error) {
+      return failure(`Sign-in request failed: ${error.message}`);
+    }
+    const auth = readAuthState();
+    if (auth.isLoggedIn !== true) {
+      return failure('Sign-in failed — the workspace rejected those credentials.');
+    }
+    return textResult({
+      success: true,
+      account: { email: auth.current?.email, role: auth.current?.role },
+      ui: 'Signed in. The full CRM tool set is now registered — re-list the tools to use it.',
+    });
+  },
+});
+
+// ask_site is registered unconditionally (both auth states).
+export const buildBaseTools = () => [askSiteTool];
+
+// Signed-out: the way in, plus the guidance-stage conversion entry.
+export const buildAnonymousTools = (ui) => [buildSignInTool(ui), buildCreateInvoiceEntryTool(ui)];
+
+// Signed-in: the working CRM set (aborted on logout).
+export const buildCrmTools = (ui) => [
+  buildCreateInvoiceTool(ui),
+  findClientsTool,
+  listInvoicesTool,
+  buildRecordPaymentTool(ui),
+  financialSummaryTool,
+];
