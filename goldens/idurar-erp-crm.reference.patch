+// Content bundle for the ask_site WebMCP tool.
+// Sections mirror what the app itself ships (pages, README, in-app copy) so
+// answers stay grounded in this product — the calling agent composes the
+// final answer from the returned sections.
+
+const SECTIONS = [
+  {
+    title: 'What is IDURAR ERP CRM',
+    source: '/about',
+    keywords: ['idurar', 'erp', 'crm', 'product', 'open source', 'tech', 'stack', 'built', 'node', 'react', 'mongodb', 'technology'],
+    text: 'IDURAR is a free open-source ERP/CRM application for accounting, invoicing and client management, built on Node.js (Express + MongoDB) and React (Ant Design). It is self-hosted back-office software: a business team signs in to manage customers, invoices and payments. IDURAR (idurarapp.com) also offers a hosted cloud and enterprise version.',
+  },
+  {
+    title: 'Signing in and accounts',
+    source: '/login',
+    keywords: ['login', 'log in', 'sign in', 'sign up', 'signing', 'signin', 'signup', 'account', 'password', 'register', 'forgot', 'access', 'credentials'],
+    text: 'Access requires signing in at /login with an email and password. There is no self-serve signup: accounts are provisioned by the workspace administrator (a default owner admin account is created when the server is set up). A "Forgot Password" flow is available at /forgetpassword. All CRM data and tools are available only after signing in.',
+  },
+  {
+    title: 'Modules',
+    source: '/',
+    keywords: ['modules', 'features', 'navigation', 'menu', 'capabilities', 'functionality'],
+    text: 'After signing in the app offers: Dashboard (financial overview), Customers (client records), Invoices (create, send, track and download as PDF), Payments (record and track payments against invoices), and Settings (company info, currency, finance settings). The invoice list is the home screen.',
+  },
+  {
+    title: 'Invoices',
+    source: '/invoice',
+    keywords: ['invoice', 'invoicing', 'billing', 'bill', 'pdf', 'status', 'draft', 'sent', 'overdue', 'due', 'cancelled', 'refunded'],
+    text: 'An invoice belongs to one client and holds line items (name, quantity, unit price), a tax rate, an issue date and a due (expired) date. Totals are computed by the server. Workflow status is one of: draft, pending, sent, refunded, cancelled, on hold. Payment status is tracked separately as unpaid, partially or paid, and updates automatically as payments are recorded. Invoices can be downloaded as PDF and emailed to the client.',
+  },
+  {
+    title: 'Recording payments',
+    source: '/payment',
+    keywords: ['payment', 'payments', 'pay', 'paid', 'record', 'receive', 'received', 'partial', 'partially', 'balance', 'credit', 'installment', 'settle'],
+    text: 'Payments are recorded against a specific invoice. Partial payments are supported: each payment increases the invoice\'s paid amount (credit) and the payment status moves from unpaid to partially to paid. A payment larger than the invoice\'s outstanding balance is rejected. Each payment stores a date, amount, optional reference and description.',
+  },
+  {
+    title: 'Customers (clients)',
+    source: '/customer',
+    keywords: ['customer', 'client', 'contact', 'email', 'phone', 'address'],
+    text: 'The Customers module stores the client records that invoices and payments attach to: name, email, phone, country and address. Clients can be searched by name and managed (create, update, delete) from the Customers page.',
+  },
+  {
+    title: 'Dashboard and reporting',
+    source: '/',
+    keywords: ['dashboard', 'report', 'reports', 'reporting', 'summary', 'overview', 'statistics', 'stats', 'revenue', 'month', 'monthly', 'week', 'year', 'performance'],
+    text: 'The Dashboard summarizes finances for a period (week, month or year): total invoiced amount, amount still due, invoice status breakdown, payments received, and client activity.',
+  },
+  {
+    title: 'Settings',
+    source: '/settings',
+    keywords: ['settings', 'currency', 'company', 'configuration', 'configure', 'tax', 'numbering'],
+    text: 'Settings cover company information (name, address, contact), general app settings, currency display, and finance settings such as the last invoice and payment numbers used for auto-numbering.',
+  },
+  {
+    title: 'Pricing and license',
+    source: 'README',
+    keywords: ['price', 'pricing', 'cost', 'free', 'license', 'licensing', 'commercial', 'enterprise', 'cloud', 'hosted'],
+    text: 'The self-hosted app is free and open source. IDURAR offers commercial options — a hosted cloud version and enterprise customization services — via idurarapp.com.',
+  },
+];
+
+// Structural words that carry no topical signal — never let them score.
+const STOPWORDS = new Set([
+  'the', 'and', 'for', 'are', 'can', 'you', 'your', 'our', 'how', 'what', 'which',
+  'where', 'when', 'why', 'who', 'this', 'that', 'these', 'those', 'does', 'did',
+  'with', 'have', 'has', 'had', 'will', 'was', 'were', 'they', 'them', 'their',
+  'there', 'here', 'about', 'into', 'from', 'some', 'any', 'all', 'not', 'but',
+  'out', 'get', 'its', 'also', 'only', 'more', 'than', 'then', 'too', 'very',
+  'just', 'like', 'still', 'after', 'before', 'been', 'both', 'each', 'other',
+  'such', 'own', 'same', 'see', 'use', 'exist', 'exists', 'need', 'want', 'should',
+  'would', 'could', 'may', 'might',
+]);
+
+const tokenize = (s) =>
+  s
+    .toLowerCase()
+    .split(/[^a-z0-9]+/)
+    .filter((w) => w.length > 2 && !STOPWORDS.has(w));
+
+// A single-word keyword matches a query token exactly or by shared prefix
+// ("payment" ~ "payments"); phrase keywords match as substrings of the query.
+const matchesKeyword = (kw, tokens, q) => {
+  if (kw.includes(' ')) return q.includes(kw);
+  return tokens.some(
+    (t) => t === kw || (kw.length >= 4 && t.startsWith(kw)) || (t.length >= 4 && kw.startsWith(t))
+  );
+};
+
+// Scores: keyword +3 (phrase +4), title word +2, body substring +1 (tokens of
+// 4+ chars only). Sections below MIN_SCORE are noise — returning them for an
+// off-topic question would be a false positive, so the tool reports an honest
+// miss instead (validated against a query battery; see the reference PR).
+const MIN_SCORE = 3;
+
+export function searchContent(query) {
+  const q = String(query).toLowerCase();
+  const tokens = tokenize(q);
+  const scored = SECTIONS.map((section) => {
+    let score = 0;
+    for (const kw of section.keywords) {
+      if (matchesKeyword(kw, tokens, q)) score += kw.includes(' ') ? 4 : 3;
+    }
+    const titleTokens = tokenize(section.title);
+    const body = section.text.toLowerCase();
+    for (const t of tokens) {
+      if (titleTokens.some((w) => w === t || w.startsWith(t) || t.startsWith(w))) score += 2;
+      if (t.length >= 4 && body.includes(t)) score += 1;
+    }
+    return { section, score };
+  })
+    .filter((s) => s.score >= MIN_SCORE)
+    .sort((a, b) => b.score - a.score)
+    .slice(0, 3);
+
+  return scored.map(({ section }) => ({
+    title: section.title,
+    source: section.source,
+    content: section.text,
+  }));
+}
+
+export const CONTENT_TOPICS = SECTIONS.map((s) => s.title);
