diff --git a/frontend/src/webmcp/WebMcp.jsx b/frontend/src/webmcp/WebMcp.jsx
new file mode 100644
index 00000000..e569477f
--- /dev/null
+++ b/frontend/src/webmcp/WebMcp.jsx
@@ -0,0 +1,68 @@
+// Registers the app's WebMCP tools (document.modelContext / navigator.modelContext)
+// and keeps the registered set in sync with the auth state:
+//   - ask_site: always registered.
+//   - signed out: sign_in (the only way into the workspace for a tools-only
+//     agent) and a guidance-stage create_invoice.
+//   - signed in: the full CRM tool set.
+// Each auth state registers under its own AbortController; flipping auth aborts
+// the previous registrations (the browser drops them) and registers the new set.
+// No-ops when the browser has no modelContext.
+
+import { useEffect, useRef } from 'react';
+import { useDispatch, useSelector } from 'react-redux';
+import { useNavigate } from 'react-router-dom';
+
+import { selectAuth } from '@/redux/auth/selectors';
+import { buildBaseTools, buildAnonymousTools, buildCrmTools } from './tools';
+
+const getModelContext = () =>
+  (typeof document !== 'undefined' && document.modelContext) ||
+  (typeof navigator !== 'undefined' && navigator.modelContext) ||
+  null;
+
+function registerTools(tools, signal) {
+  const ctx = getModelContext();
+  if (!ctx || typeof ctx.registerTool !== 'function') return;
+  for (const tool of tools) {
+    try {
+      const registration = ctx.registerTool(tool, { signal });
+      // Some builds reject async (e.g. duplicate name) — never crash the app.
+      if (registration && typeof registration.catch === 'function') {
+        registration.catch((error) => {
+          if (!signal.aborted) {
+            console.warn('WebMCP registration failed:', tool.name, error);
+          }
+        });
+      }
+    } catch (error) {
+      if (!signal.aborted) {
+        console.warn('WebMCP registration failed:', tool.name, error);
+      }
+    }
+  }
+}
+
+export default function WebMcp() {
+  const { isLoggedIn } = useSelector(selectAuth);
+  const navigate = useNavigate();
+  const dispatch = useDispatch();
+  const navigateRef = useRef(navigate);
+  navigateRef.current = navigate;
+
+  useEffect(() => {
+    if (!getModelContext()) return undefined;
+    const controller = new AbortController();
+    registerTools(buildBaseTools(), controller.signal);
+    return () => controller.abort();
+  }, []);
+
+  useEffect(() => {
+    if (!getModelContext()) return undefined;
+    const controller = new AbortController();
+    const ui = { navigate: (to) => navigateRef.current(to), dispatch };
+    registerTools(isLoggedIn ? buildCrmTools(ui) : buildAnonymousTools(ui), controller.signal);
+    return () => controller.abort();
+  }, [isLoggedIn]);
+
+  return null;
+}
