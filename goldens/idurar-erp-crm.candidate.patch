+++ b/frontend/src/webmcp/get_invoice.js
@@ -0,0 +1,68 @@
+import { defineTool } from '@nekuda/webmcp';
+import { erp } from '@/redux/erp/actions';
+import {
+  balanceDue,
+  customerSummary,
+  dispatch,
+  goTo,
+  invoiceSummary,
+  money,
+  resolveInvoice,
+} from './runtime';
+
+export const getInvoice = defineTool({
+  stableKey: 'billing.invoices.get',
+  name: 'get_invoice',
+  title: 'Open an invoice',
+  description:
+    'Open one invoice and return its full detail, identified by its invoice number (with year) or its id. Use this after find_invoices when you need the line items, the tax and totals breakdown, or the exact balance still due before recording a payment. Returns the customer, dates, every line item with quantity and price, subtotal, tax, total, amount already paid, balance due, status, and payment status, and navigates the page to that invoice.',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      number: {
+        type: 'integer',
+        description: 'The invoice number as shown in the invoice table. Use with year.',
+      },
+      year: {
+        type: 'integer',
+        description: "The invoice's year. Defaults to the current year when a number is given.",
+      },
+      invoice_id: {
+        type: 'string',
+        description:
+          "The invoice's id, if you already have it from another tool. Use instead of number and year.",
+      },
+    },
+    additionalProperties: false,
+  },
+  annotations: { readOnlyHint: true },
+  async execute({ number, year, invoice_id } = {}) {
+    const invoice = await resolveInvoice({ invoice_id, number, year });
+
+    // Seed the app's current-item state before navigating so the invoice page
+    // renders this record straight away instead of flashing its loader.
+    await dispatch(erp.currentItem({ data: invoice }));
+    goTo(`/invoice/read/${invoice._id}`);
+
+    return {
+      invoice: {
+        ...invoiceSummary(invoice),
+        customer_details: customerSummary(invoice.client),
+        notes: invoice.notes || null,
+        items: (invoice.items || []).map((item) => ({
+          item_name: item.itemName,
+          description: item.description || null,
+          quantity: item.quantity,
+          price: money(item.price),
+          total: money(item.total),
+        })),
+        sub_total: money(invoice.subTotal),
+        tax_rate: invoice.taxRate ?? 0,
+        tax_total: money(invoice.taxTotal),
+        discount: money(invoice.discount),
+        balance_due: balanceDue(invoice),
+        payment_count: (invoice.payment || []).length,
+      },
+    };
+  },
+});
diff --git a/frontend/src/webmcp/payment_intents.js b/frontend/src/webmcp/payment_intents.js
new file mode 100644
index 0000000..513ac26
--- /dev/null
+++ b/frontend/src/webmcp/payment_intents.js
@@ -0,0 +1,47 @@
+// The handshake behind the two payment tools. Recording money against an invoice
+// has no undo in this app, so no single agent call is allowed to do it: one tool
+// quotes the payment and mints a token here, a second tool spends the token.
+//
+// Intents live in memory only and are deliberately not persisted — a token must
+// not survive a reload, cross a tab, or outlive the signed-in session.
+
+const TTL_MS = 10 * 60 * 1000;
+
+const intents = new Map();
+let sequence = 0;
+
+export function createIntent(details) {
+  sequence += 1;
+  const token = `pay_${Date.now().toString(36)}_${sequence.toString(36)}`;
+  intents.set(token, { ...details, expiresAt: Date.now() + TTL_MS });
+  return token;
+}
+
+// Single use: the token is spent on the first claim whether or not the write that
+// follows succeeds, so a failed attempt has to be re-quoted rather than retried
+// blind against a balance that may have moved.
+export function claimIntent(token) {
+  const key = String(token || '').trim();
+  if (!key) {
+    throw new Error('a confirmation token from prepare_invoice_payment is required');
+  }
+
+  const intent = intents.get(key);
+  if (!intent) {
+    throw new Error(
+      'that confirmation token is not valid — it was already used, or the page reloaded since it was issued. Call prepare_invoice_payment again.'
+    );
+  }
+  intents.delete(key);
+
+  if (Date.now() > intent.expiresAt) {
+    throw new Error(
+      'that confirmation token has expired. Call prepare_invoice_payment again to re-check the balance.'
+    );
+  }
+  return intent;
+}
+
+export function clearIntents() {
+  intents.clear();
+}
diff --git a/frontend/src/webmcp/prepare_invoice_payment.js b/frontend/src/webmcp/prepare_invoice_payment.js
new file mode 100644
index 0000000..02c5ae8
--- /dev/null
+++ b/frontend/src/webmcp/prepare_invoice_payment.js
@@ -0,0 +1,83 @@
+import { defineTool } from '@nekuda/webmcp';
+import { erp } from '@/redux/erp/actions';
+import { balanceDue, dispatch, goTo, money, resolveInvoice } from './runtime';
+import { createIntent } from './payment_intents';
+
+export const prepareInvoicePayment = defineTool({
+  stableKey: 'billing.payments.prepare',
+  name: 'prepare_invoice_payment',
+  title: 'Check a payment before recording it',
+  description:
+    'Check a payment against an invoice before any money is recorded, and open that invoice so it is visible on screen. Use this first whenever you intend to record a payment: it confirms the invoice exists, computes the balance still due, rejects an amount above that balance, and returns a confirmation token. Nothing is written. Returns the invoice number, customer, currency, balance due, the amount that would be recorded, the balance that would remain, and the token that confirm_invoice_payment requires.',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      number: {
+        type: 'integer',
+        description: 'The invoice number to pay against. Use with year.',
+      },
+      year: {
+        type: 'integer',
+        description: "The invoice's year. Defaults to the current year when a number is given.",
+      },
+      invoice_id: {
+        type: 'string',
+        description: "The invoice's id, if you already have it. Use instead of number and year.",
+      },
+      amount: {
+        type: 'number',
+        exclusiveMinimum: 0,
+        description: 'The amount to record. Must be above 0 and no more than the balance due.',
+      },
+    },
+    required: ['amount'],
+    additionalProperties: false,
+  },
+  annotations: { readOnlyHint: true },
+  async execute({ number, year, invoice_id, amount } = {}) {
+    const requested = money(amount);
+    if (!Number.isFinite(requested) || requested <= 0) {
+      throw new Error('the payment amount must be above 0');
+    }
+
+    const invoice = await resolveInvoice({ invoice_id, number, year });
+    const due = balanceDue(invoice);
+    const label = `invoice ${invoice.number}/${invoice.year}`;
+
+    if (due <= 0) {
+      throw new Error(
+        `${label} has nothing outstanding — it is already marked ${invoice.paymentStatus}`
+      );
+    }
+    if (requested > due) {
+      throw new Error(
+        `${requested} is more than the ${due} still due on ${label} — this app will not accept an overpayment`
+      );
+    }
+
+    // Put the invoice on screen so the person being acted for can see what is
+    // about to be paid before the confirming call is made.
+    await dispatch(erp.currentItem({ data: invoice }));
+    goTo(`/invoice/read/${invoice._id}`);
+
+    const token = createIntent({
+      invoiceId: invoice._id,
+      invoiceNumber: invoice.number,
+      invoiceYear: invoice.year,
+      clientId: invoice.client?._id || invoice.client,
+      amount: requested,
+    });
+
+    return {
+      token,
+      invoice_number: invoice.number,
+      invoice_year: invoice.year,
+      customer: invoice.client?.name || null,
+      currency: invoice.currency,
+      balance_due: due,
+      amount_to_record: requested,
+      balance_after: money(due - requested),
+      note: 'Nothing has been recorded yet. Confirm the amount, then call confirm_invoice_payment with this token.',
+    };
+  },
+});
diff --git a/frontend/src/webmcp/runtime.js b/frontend/src/webmcp/runtime.js
new file mode 100644
index 0000000..6ec7946
--- /dev/null
+++ b/frontend/src/webmcp/runtime.js
@@ -0,0 +1,189 @@
+import store from '@/redux/store';
+import { request } from '@/request';
+
+// Shared plumbing for the WebMCP tool modules. Every tool goes through the app's
+// own redux actions and request layer, so it runs on the signed-in admin's
+// session and the page the user is looking at moves with it.
+
+let navigateFn = null;
+
+// The router's navigate() only exists inside the component tree, so the provider
+// hands it over on mount and takes it back on unmount.
+export function setNavigate(fn) {
+  navigateFn = fn;
+}
+
+export function goTo(path) {
+  if (typeof navigateFn !== 'function') {
+    throw new Error('cannot navigate: the WebMCP tool provider is not mounted');
+  }
+  navigateFn(path);
+}
+
+export function dispatch(action) {
+  return store.dispatch(action);
+}
+
+export function getState() {
+  return store.getState();
+}
+
+// IDURAR answers every API call with { success, result, message }. Anything other
+// than success is the server refusing, and the agent has to hear why.
+export function unwrap(response, action) {
+  if (!response || response.success !== true) {
+    throw new Error(`${action} failed: ${response?.message || 'the server refused the request'}`);
+  }
+  return response.result;
+}
+
+function currentSettings() {
+  return store.getState().settings?.result || {};
+}
+
+export function financeSettings() {
+  const finance = currentSettings().finance_settings;
+  if (!finance || finance.last_invoice_number === undefined) {
+    throw new Error('the app has not loaded its finance settings yet — reload the page and retry');
+  }
+  return finance;
+}
+
+export function defaultCurrency() {
+  return currentSettings().money_format_settings?.default_currency_code || 'USD';
+}
+
+const OBJECT_ID = /^[a-f\d]{24}$/i;
+
+export function isObjectId(value) {
+  return OBJECT_ID.test(String(value || '').trim());
+}
+
+export function asDateOnly(value, label) {
+  if (value === undefined || value === null || value === '') return null;
+  const parsed = new Date(value);
+  if (Number.isNaN(parsed.getTime())) {
+    throw new Error(`${label} is not a date this app understands: "${value}" (use YYYY-MM-DD)`);
+  }
+  return parsed.toISOString();
+}
+
+// Money in this app is stored as plain numbers, so keep the rounding in one place
+// rather than letting each tool invent its own.
+export function money(value) {
+  return Math.round((Number(value) || 0) * 100) / 100;
+}
+
+export function balanceDue(invoice) {
+  return money((invoice.total || 0) - (invoice.discount || 0) - (invoice.credit || 0));
+}
+
+// Both the invoicing tools and the invoice filter need to turn whatever the agent
+// called a customer into one specific record, and both must refuse to guess.
+export async function resolveCustomer(customer) {
+  const value = String(customer || '').trim();
+  if (!value) {
+    throw new Error('a customer name or id is required');
+  }
+
+  if (isObjectId(value)) {
+    return unwrap(
+      await request.read({ entity: 'client', id: value }),
+      `looking up customer ${value}`
+    );
+  }
+
+  const matches = unwrap(
+    await request.list({
+      entity: 'client',
+      options: { q: value, fields: 'name,email', page: 1, items: 20 },
+    }),
+    `searching customers for "${value}"`
+  );
+
+  const exact = matches.filter((item) => item.name?.toLowerCase() === value.toLowerCase());
+  const shortlist = exact.length > 0 ? exact : matches;
+
+  if (shortlist.length === 0) {
+    throw new Error(`no customer matches "${value}" — add one with create_customer first`);
+  }
+  if (shortlist.length > 1) {
+    const names = shortlist.map((item) => item.name).join(', ');
+    throw new Error(
+      `"${value}" matches ${shortlist.length} customers (${names}) — pass the exact name or the customer id`
+    );
+  }
+  return shortlist[0];
+}
+
+// Agents know an invoice by the number printed on it, not by its database id, so
+// every invoice-shaped tool accepts either and lands on one record or throws.
+export async function resolveInvoice({ invoice_id, number, year } = {}) {
+  if (invoice_id) {
+    if (!isObjectId(invoice_id)) {
+      throw new Error(`"${invoice_id}" is not an invoice id`);
+    }
+    return unwrap(
+      await request.read({ entity: 'invoice', id: invoice_id }),
+      `opening invoice ${invoice_id}`
+    );
+  }
+
+  if (number === undefined || number === null || number === '') {
+    throw new Error('pass an invoice number (with its year), or an invoice_id');
+  }
+
+  const wantedYear = year ?? new Date().getFullYear();
+  const sameNumber = unwrap(
+    await request.list({
+      entity: 'invoice',
+      options: { filter: 'number', equal: number, page: 1, items: 50 },
+    }),
+    `looking up invoice ${number}`
+  );
+
+  const found = sameNumber.find((item) => item.year === wantedYear);
+  if (!found) {
+    const years = [...new Set(sameNumber.map((item) => item.year))].sort();
+    throw new Error(
+      years.length > 0
+        ? `there is no invoice ${number} for ${wantedYear} — invoice ${number} exists for ${years.join(', ')}`
+        : `there is no invoice numbered ${number}`
+    );
+  }
+
+  return unwrap(
+    await request.read({ entity: 'invoice', id: found._id }),
+    `opening invoice ${number}/${wantedYear}`
+  );
+}
+
+export function customerSummary(client) {
+  if (!client) return null;
+  return {
+    id: client._id,
+    name: client.name,
+    email: client.email || null,
+    phone: client.phone || null,
+    country: client.country || null,
+    address: client.address || null,
+  };
+}
+
+export function invoiceSummary(invoice) {
+  return {
+    id: invoice._id,
+    number: invoice.number,
+    year: invoice.year,
+    customer: invoice.client?.name || null,
+    customer_id: invoice.client?._id || invoice.client || null,
+    date: invoice.date,
+    due_date: invoice.expiredDate,
+    currency: invoice.currency,
+    total: money(invoice.total),
+    paid: money(invoice.credit),
+    balance_due: balanceDue(invoice),
+    status: invoice.status,
+    payment_status: invoice.paymentStatus,
+  };
+}
