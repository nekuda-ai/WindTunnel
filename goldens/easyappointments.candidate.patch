diff --git a/assets/js/webmcp/list_services.js b/assets/js/webmcp/list_services.js
new file mode 100644
index 0000000..f77edb5
--- /dev/null
+++ b/assets/js/webmcp/list_services.js
@@ -0,0 +1,102 @@
+/* ----------------------------------------------------------------------------
+ * Easy!Appointments - Online Appointment Scheduler
+ *
+ * @package     EasyAppointments
+ * @author      A.Tselegidis <alextselegidis@gmail.com>
+ * @copyright   Copyright (c) Alex Tselegidis
+ * @license     https://opensource.org/licenses/GPL-3.0 - GPLv3
+ * @link        https://easyappointments.org
+ * ---------------------------------------------------------------------------- */
+
+/**
+ * WebMCP tool: list_services.
+ *
+ * Reads the booking page's own service and provider lists - the exact arrays the wizard renders its
+ * first step from - so the agent and the visitor always see the same catalogue.
+ */
+
+import {defineTool} from '@nekuda/webmcp';
+import {availableProviders, availableServices, requireBookingWizard} from './support.js';
+
+/**
+ * Describe the providers that offer a service.
+ *
+ * @param {Number|String} serviceId Service ID.
+ *
+ * @return {Array<Object>} Returns the matching providers.
+ */
+function providersForService(serviceId) {
+    return availableProviders()
+        .filter((provider) => (provider.services ?? []).map(Number).includes(Number(serviceId)))
+        .map((provider) => ({
+            provider_id: Number(provider.id),
+            name: `${provider.first_name} ${provider.last_name}`.trim(),
+            timezone: provider.timezone,
+        }));
+}
+
+export const listServices = defineTool({
+    stableKey: 'booking.services.list',
+    name: 'list_services',
+    title: 'List bookable services',
+    description:
+        'List the services this business offers for online booking. Each entry gives the service id, name, ' +
+        'description, duration in minutes, price and currency, and the providers who deliver it with their ids and ' +
+        'timezone. Use this first to identify the service the visitor means and to get the service_id and ' +
+        'provider_id that check_availability and book_appointment need. Optionally filter by a name fragment. ' +
+        'Read-only — the page does not change.',
+    inputSchema: {
+        type: 'object',
+        properties: {
+            name_contains: {
+                type: 'string',
+                description: 'Only return services whose name or description contains this text.',
+                minLength: 1,
+            },
+        },
+        required: [],
+        additionalProperties: false,
+    },
+    annotations: {readOnlyHint: true, untrustedContentHint: false},
+    async execute({name_contains: nameContains} = {}) {
+        requireBookingWizard();
+
+        const services = availableServices();
+
+        const describe = (service) => ({
+            service_id: Number(service.id),
+            name: service.name,
+            description: service.description ?? null,
+            duration_minutes: Number(service.duration),
+            price: Number(service.price),
+            currency: service.currency,
+            category: service.service_category_name ?? null,
+            location: service.location ?? null,
+            providers: providersForService(service.id),
+        });
+
+        if (!nameContains) {
+            return {services: services.map(describe)};
+        }
+
+        const needle = nameContains.toLowerCase();
+
+        const matches = services.filter(
+            (service) =>
+                service.name.toLowerCase().includes(needle) ||
+                (service.description ?? '').toLowerCase().includes(needle),
+        );
+
+        if (!matches.length) {
+            return {
+                services: [],
+                note:
+                    `No bookable service matches "${nameContains}". This business offers: ` +
+                    services.map((service) => service.name).join(', ') +
+                    '.',
+            };
+        }
+
+        return {services: matches.map(describe)};
+    },
+});
diff --git a/assets/js/webmcp/reschedule_appointment.js b/assets/js/webmcp/reschedule_appointment.js
new file mode 100644
index 0000000..f0d3cc6
--- /dev/null
+++ b/assets/js/webmcp/reschedule_appointment.js
@@ -0,0 +1,126 @@
+/* ----------------------------------------------------------------------------
+ * Easy!Appointments - Online Appointment Scheduler
+ *
+ * @package     EasyAppointments
+ * @author      A.Tselegidis <alextselegidis@gmail.com>
+ * @copyright   Copyright (c) Alex Tselegidis
+ * @license     https://opensource.org/licenses/GPL-3.0 - GPLv3
+ * @link        https://easyappointments.org
+ * ---------------------------------------------------------------------------- */
+
+/**
+ * WebMCP tool: reschedule_appointment.
+ *
+ * Registered only on an appointment's own reschedule page, where the site has already resolved the
+ * appointment from its hash. The tool moves that appointment through the same wizard the visitor
+ * would use, and never takes an appointment id of its own.
+ */
+
+import {defineTool} from '@nekuda/webmcp';
+import {ANY_PROVIDER, findService, isManageMode, pageVar, requireBookingWizard, resolveProviderId} from './support.js';
+import {
+    advanceToConfirmation,
+    confirmationUrl,
+    fillCustomerForm,
+    readPostData,
+    requireConsentGiven,
+    selectHour,
+    selectServiceProviderDate,
+    selectedTimezone,
+    submitRegistration,
+} from './wizard.js';
+
+const DATE_PATTERN = /^\d{4}-\d{2}-\d{2}$/;
+const TIME_PATTERN = /^\d{2}:\d{2}$/;
+
+export const rescheduleAppointment = defineTool({
+    stableKey: 'booking.appointment.reschedule',
+    name: 'reschedule_appointment',
+    title: 'Move this appointment',
+    description:
+        'Move the appointment shown on this page to a different date and time, and optionally to a different ' +
+        "service or provider. This tool is only available on an appointment's own reschedule page, where the " +
+        'appointment is already fixed — you never pass its id. Confirm the new slot with check_availability first. ' +
+        "This updates the appointment in the business's schedule and emails the customer. Returns the " +
+        "appointment's confirmation hash and its new start time.",
+    inputSchema: {
+        type: 'object',
+        properties: {
+            date: {
+                type: 'string',
+                description: 'The new appointment day, as YYYY-MM-DD.',
+                pattern: '^\\d{4}-\\d{2}-\\d{2}$',
+            },
+            time: {
+                type: 'string',
+                description: 'The new start time as HH:mm, exactly as check_availability returned it.',
+                pattern: '^\\d{2}:\\d{2}$',
+            },
+            service_id: {
+                type: 'integer',
+                description: 'Optional. Switch the appointment to a different service.',
+            },
+            provider_id: {
+                description: 'Optional. Switch the appointment to a different provider, or "any-provider".',
+                anyOf: [{type: 'integer'}, {type: 'string', enum: [ANY_PROVIDER]}],
+            },
+            notes: {type: 'string', description: 'Optional. Replace the note the provider sees.'},
+        },
+        required: ['date', 'time'],
+        additionalProperties: false,
+    },
+    annotations: {readOnlyHint: false, untrustedContentHint: false},
+    async execute(input) {
+        requireBookingWizard();
+
+        if (!isManageMode()) {
+            throw new Error(
+                'There is no appointment on this page to move. Open the reschedule link from the booking ' +
+                    'confirmation email first.',
+            );
+        }
+
+        if (!DATE_PATTERN.test(input.date)) {
+            throw new Error(`"${input.date}" is not a date. Pass the day as YYYY-MM-DD.`);
+        }
+
+        if (!TIME_PATTERN.test(input.time)) {
+            throw new Error(`"${input.time}" is not a time. Pass the start time as HH:mm.`);
+        }
+
+        const appointment = pageVar('appointment_data');
+        const previousStart = appointment.start_datetime;
+
+        const service = findService(input.service_id ?? appointment.id_services);
+        const providerId = resolveProviderId(service.id, input.provider_id ?? appointment.id_users_provider);
+
+        await selectServiceProviderDate(String(service.id), providerId, input.date);
+
+        selectHour(input.time, input.date);
+
+        if (input.notes !== undefined) {
+            fillCustomerForm({notes: input.notes});
+        }
+
+        await advanceToConfirmation();
+
+        requireConsentGiven();
+
+        const postData = readPostData();
+        const response = await submitRegistration(postData, appointment.id);
+        const url = confirmationUrl(response.appointment_hash);
+
+        window.location.assign(url);
+
+        return {
+            appointment_hash: response.appointment_hash,
+            previous_start_datetime: previousStart,
+            start_datetime: postData.appointment.start_datetime,
+            end_datetime: postData.appointment.end_datetime,
+            service: {service_id: Number(service.id), name: service.name},
+            provider_id: providerId,
+            displayed_timezone: selectedTimezone(),
+            confirmation_url: url,
+        };
+    },
+});
diff --git a/assets/js/webmcp/support.js b/assets/js/webmcp/support.js
new file mode 100644
index 0000000..b8c98b5
--- /dev/null
+++ b/assets/js/webmcp/support.js
@@ -0,0 +1,287 @@
+/* ----------------------------------------------------------------------------
+ * Easy!Appointments - Online Appointment Scheduler
+ *
+ * @package     EasyAppointments
+ * @author      A.Tselegidis <alextselegidis@gmail.com>
+ * @copyright   Copyright (c) Alex Tselegidis
+ * @license     https://opensource.org/licenses/GPL-3.0 - GPLv3
+ * @link        https://easyappointments.org
+ * ---------------------------------------------------------------------------- */
+
+/**
+ * WebMCP support helpers.
+ *
+ * Shared, side-effect-free helpers for the WebMCP tool modules. Everything here reads the page's own
+ * state (the `vars()` script variables and the `App.*` client modules) or talks to the same booking
+ * routes the page itself calls - no separate data source is introduced.
+ */
+
+const ANY_PROVIDER = 'any-provider';
+
+/**
+ * Read a page script variable.
+ *
+ * @param {String} key Variable name.
+ *
+ * @return {*} Returns the variable value, or undefined when the page did not publish it.
+ */
+export function pageVar(key) {
+    if (typeof window.vars !== 'function') {
+        throw new Error('The page did not publish its script variables, so the booking data is unavailable.');
+    }
+
+    return window.vars(key);
+}
+
+/**
+ * Build an absolute site URL with the app's own URL helper.
+ *
+ * @param {String} uri Relative URI.
+ *
+ * @return {String} Returns the absolute URL.
+ */
+export function siteUrl(uri) {
+    if (!window.App?.Utils?.Url?.siteUrl) {
+        throw new Error('The page has not loaded its URL helper yet.');
+    }
+
+    return window.App.Utils.Url.siteUrl(uri);
+}
+
+/**
+ * Whether the booking wizard is present on the current page.
+ *
+ * @return {Boolean}
+ */
+export function hasBookingWizard() {
+    return Boolean(document.getElementById('select-service') && document.getElementById('available-hours'));
+}
+
+/**
+ * Whether the page is showing an existing appointment (the reschedule / manage page).
+ *
+ * @return {Boolean}
+ */
+export function isManageMode() {
+    return Boolean(pageVar('manage_mode')) && Boolean(pageVar('appointment_data'));
+}
+
+/**
+ * Assert that the booking wizard is usable on this page.
+ */
+export function requireBookingWizard() {
+    if (!hasBookingWizard()) {
+        throw new Error('This tool only works on the booking page of this site.');
+    }
+}
+
+/**
+ * The services the site currently offers for online booking.
+ *
+ * @return {Array}
+ */
+export function availableServices() {
+    const services = pageVar('available_services');
+
+    if (!Array.isArray(services)) {
+        throw new Error('The booking page did not publish its service list.');
+    }
+
+    return services;
+}
+
+/**
+ * The providers the site currently offers for online booking.
+ *
+ * @return {Array}
+ */
+export function availableProviders() {
+    const providers = pageVar('available_providers');
+
+    if (!Array.isArray(providers)) {
+        throw new Error('The booking page did not publish its provider list.');
+    }
+
+    return providers;
+}
+
+/**
+ * Find a service by ID, or throw with the ids that do exist.
+ *
+ * @param {Number|String} serviceId Service ID.
+ *
+ * @return {Object} Returns the service.
+ */
+export function findService(serviceId) {
+    const services = availableServices();
+    const service = services.find((item) => Number(item.id) === Number(serviceId));
+
+    if (!service) {
+        const known = services.map((item) => `${item.id} (${item.name})`).join(', ');
+
+        throw new Error(`There is no bookable service with id ${serviceId}. Available services: ${known}.`);
+    }
+
+    return service;
+}
+
+/**
+ * Find a provider by ID, or throw with the ids that do exist.
+ *
+ * @param {Number|String} providerId Provider ID.
+ *
+ * @return {Object} Returns the provider.
+ */
+export function findProvider(providerId) {
+    const providers = availableProviders();
+    const provider = providers.find((item) => Number(item.id) === Number(providerId));
+
+    if (!provider) {
+        const known = providers.map((item) => `${item.id} (${item.first_name} ${item.last_name})`).join(', ');
+
+        throw new Error(`There is no provider with id ${providerId}. Available providers: ${known}.`);
+    }
+
+    return provider;
+}
+
+/**
+ * Resolve the provider to book with, defaulting to the first one that offers the service.
+ *
+ * @param {Number|String} serviceId Service ID.
+ * @param {Number|String|null} [providerId] Requested provider, or the "any-provider" sentinel.
+ *
+ * @return {String} Returns the provider ID as the booking form expects it.
+ */
+export function resolveProviderId(serviceId, providerId) {
+    if (providerId === ANY_PROVIDER) {
+        if (String(pageVar('display_any_provider')) !== '1') {
+            throw new Error('This site does not let the visitor leave the provider choice open.');
+        }
+
+        return ANY_PROVIDER;
+    }
+
+    if (providerId !== undefined && providerId !== null && providerId !== '') {
+        const provider = findProvider(providerId);
+
+        if (!provider.services.map(Number).includes(Number(serviceId))) {
+            throw new Error(
+                `${provider.first_name} ${provider.last_name} does not offer service ${serviceId}. ` +
+                    'Call list_services to see who offers what.',
+            );
+        }
+
+        return String(provider.id);
+    }
+
+    const match = availableProviders().find((provider) => provider.services.map(Number).includes(Number(serviceId)));
+
+    if (!match) {
+        throw new Error(`No provider currently offers service ${serviceId}, so it cannot be booked.`);
+    }
+
+    return String(match.id);
+}
+
+/**
+ * Encode a (possibly nested) payload the way the site's own forms post it.
+ *
+ * CodeIgniter reads `post_data` as a PHP array, so nested values have to arrive as
+ * `post_data[appointment][start_datetime]` rather than as JSON.
+ *
+ * @param {Object} payload Payload to encode.
+ * @param {String} [prefix] Internal - parent key while recursing.
+ * @param {URLSearchParams} [target] Internal - accumulator while recursing.
+ *
+ * @return {URLSearchParams} Returns the encoded body.
+ */
+export function encodeForm(payload, prefix = '', target = new URLSearchParams()) {
+    for (const [key, value] of Object.entries(payload)) {
+        const name = prefix ? `${prefix}[${key}]` : key;
+
+        if (value === undefined || value === null) {
+            continue;
+        }
+
+        if (typeof value === 'object' && !Array.isArray(value)) {
+            encodeForm(value, name, target);
+            continue;
+        }
+
+        target.append(name, typeof value === 'boolean' ? String(Number(value)) : String(value));
+    }
+
+    return target;
+}
+
+/**
+ * Post to one of the site's own booking routes, on the visitor's existing session.
+ *
+ * @param {String} uri Relative URI, e.g. "booking/get_available_hours".
+ * @param {Object} payload Request payload.
+ *
+ * @return {Promise<*>} Returns the decoded JSON response.
+ */
+export async function postToSite(uri, payload) {
+    const response = await fetch(siteUrl(uri), {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: {'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'},
+        body: encodeForm({csrf_token: pageVar('csrf_token'), ...payload}).toString(),
+    });
+
+    return readJsonResponse(response, uri);
+}
+
+/**
+ * Read one of the site's own booking routes, on the visitor's existing session.
+ *
+ * @param {String} uri Relative URI, e.g. "booking/get_unavailable_dates".
+ * @param {Object} payload Query payload.
+ *
+ * @return {Promise<*>} Returns the decoded JSON response.
+ */
+export async function getFromSite(uri, payload) {
+    const query = encodeForm({csrf_token: pageVar('csrf_token'), ...payload}).toString();
+
+    const response = await fetch(`${siteUrl(uri)}?${query}`, {
+        method: 'GET',
+        credentials: 'same-origin',
+        headers: {'X-Requested-With': 'XMLHttpRequest'},
+    });
+
+    return readJsonResponse(response, uri);
+}
+
+/**
+ * Decode a booking route response, surfacing the site's own error message when it fails.
+ *
+ * @param {Response} response Fetch response.
+ * @param {String} uri Relative URI the response came from.
+ *
+ * @return {Promise<*>} Returns the decoded JSON body.
+ */
+async function readJsonResponse(response, uri) {
+    const body = await response.text();
+
+    if (!response.ok) {
+        let message = body.slice(0, 300);
+
+        try {
+            message = JSON.parse(body).message ?? message;
+        } catch {
+            // The site returned an HTML error page; the truncated body is the best detail available.
+        }
+
+        throw new Error(`The site rejected the "${uri}" request (HTTP ${response.status}): ${message}`);
+    }
+
+    try {
+        return JSON.parse(body);
+    } catch {
+        throw new Error(`The site returned a non-JSON response for "${uri}": ${body.slice(0, 300)}`);
+    }
+}
+
+export {ANY_PROVIDER};
diff --git a/assets/js/webmcp/wizard.js b/assets/js/webmcp/wizard.js
