@@ -0,0 +1,334 @@
+/* ----------------------------------------------------------------------------
+ * Easy!Appointments - Online Appointment Scheduler
+ *
+ * @package     EasyAppointments
+ * @author      A.Tselegidis <alextselegidis@gmail.com>
+ * @copyright   Copyright (c) Alex Tselegidis
+ * @license     https://opensource.org/licenses/GPL-3.0 - GPLv3
+ * @link        https://easyappointments.org
+ * ---------------------------------------------------------------------------- */
+
+/**
+ * WebMCP booking wizard driver.
+ *
+ * Drives the four-step booking wizard through its own controls and its own client modules, so a tool
+ * call leaves the page in exactly the state a visitor would have reached by hand. Nothing here talks
+ * to the database or re-implements the wizard's rules - it presses the same buttons.
+ */
+
+import {pageVar, postToSite, siteUrl} from './support.js';
+
+const STEP_TRANSITION_TIMEOUT = 8000;
+
+/**
+ * Poll until a condition holds.
+ *
+ * @param {Function} predicate Condition to test; its truthy return value is resolved.
+ * @param {String} message Error message used when the condition never holds.
+ * @param {Number} [timeout] Milliseconds to wait.
+ *
+ * @return {Promise<*>} Returns the predicate's truthy value.
+ */
+export async function waitFor(predicate, message, timeout = STEP_TRANSITION_TIMEOUT) {
+    const deadline = Date.now() + timeout;
+
+    for (;;) {
+        const value = predicate();
+
+        if (value) {
+            return value;
+        }
+
+        if (Date.now() > deadline) {
+            throw new Error(message);
+        }
+
+        await new Promise((resolve) => setTimeout(resolve, 100));
+    }
+}
+
+/**
+ * The date the wizard's date picker is currently on.
+ *
+ * @return {String|null} Returns the date as Y-m-d, or null when nothing is picked.
+ */
+function pickedDate() {
+    const value = window.App.Utils.UI.getDateTimePickerValue(window.$('#select-date'));
+
+    return value ? window.moment(value).format('YYYY-MM-DD') : null;
+}
+
+/**
+ * Wait until the slot list has finished loading - either it holds slots, or it says there are none.
+ *
+ * @param {String} date Date being loaded, for the error message.
+ *
+ * @return {Promise<void>}
+ */
+async function settleSlots(date) {
+    const $availableHours = window.$('#available-hours');
+
+    await waitFor(
+        () => $availableHours.find('.available-hour').length > 0 || $availableHours.text().trim().length > 0,
+        `The site never finished loading the appointment slots for ${date}.`,
+    );
+}
+
+/**
+ * Point the wizard at a service, provider and date, and load that date's slots.
+ *
+ * The wizard fetches a month's unavailable dates in the background whenever it enters step 2, and
+ * that response re-selects the first free date of the month when it lands. So the picked date is
+ * re-asserted until it sticks, rather than assumed.
+ *
+ * @param {String} serviceId Service ID.
+ * @param {String} providerId Provider ID, or the "any-provider" sentinel.
+ * @param {String} date Selected date (Y-m-d).
+ *
+ * @return {Promise<void>}
+ */
+export async function selectServiceProviderDate(serviceId, providerId, date) {
+    const $ = window.$;
+
+    $('#select-service').val(String(serviceId)).trigger('change');
+    $('#select-provider').val(String(providerId)).trigger('change');
+
+    // Step 1 owns the service and provider choice; the wizard's own "next" button is what moves the
+    // visitor on to the date and time step and reveals the slot list.
+    const $firstStep = $('#wizard-frame-1');
+
+    if ($firstStep.is(':visible')) {
+        $firstStep.find('.button-next').trigger('click');
+
+        await waitFor(
+            () => $('#wizard-frame-2').is(':visible'),
+            'The booking form never reached its date and time step.',
+        );
+
+        await settleSlots(date);
+    }
+
+    for (let attempt = 1; attempt <= 3; attempt++) {
+        window.App.Utils.UI.setDateTimePickerValue($('#select-date'), new Date(`${date}T00:00`));
+        window.App.Http.Booking.getAvailableHours(date);
+
+        await settleSlots(date);
+
+        // Give a late month-availability response the chance to move the date before trusting it.
+        await new Promise((resolve) => setTimeout(resolve, 250));
+
+        if (pickedDate() === date) {
+            return;
+        }
+    }
+
+    throw new Error(`The booking form would not stay on ${date}; the site keeps moving it to ${pickedDate()}.`);
+}
+
+/**
+ * Select one of the rendered slots, the way clicking it would.
+ *
+ * @param {String} time Slot start time in the provider's timezone (HH:mm).
+ * @param {String} date Selected date, for the error message.
+ */
+export function selectHour(time, date) {
+    const $ = window.$;
+
+    const $slots = $('#available-hours .available-hour');
+
+    const $exact = $slots.filter((index, element) => String($(element).data('value')) === time);
+
+    if (!$exact.length) {
+        const offered = $slots.map((index, element) => String($(element).data('value'))).get();
+
+        throw new Error(
+            `${time} is not a free slot on ${date}. ` +
+                (offered.length
+                    ? `Free start times that day: ${offered.join(', ')}.`
+                    : 'Nothing is free that day at all.'),
+        );
+    }
+
+    $exact.first().trigger('click');
+}
+
+/**
+ * Fill the customer step with the details the visitor supplied.
+ *
+ * Only the fields actually passed are written, so the reschedule page keeps the customer details it
+ * already rendered.
+ *
+ * @param {Object} fields Field values keyed by their input id, e.g. {'first-name': 'Ada'}.
+ */
+export function fillCustomerForm(fields) {
+    const $ = window.$;
+
+    for (const [id, value] of Object.entries(fields)) {
+        if (value === undefined || value === null) {
+            continue;
+        }
+
+        const $field = $(`#${id}`);
+
+        if (!$field.length) {
+            throw new Error(`This booking form has no "${id}" field, so that detail cannot be supplied.`);
+        }
+
+        $field.val(String(value)).trigger('change');
+    }
+}
+
+/**
+ * Refuse to proceed while the visitor still has to agree to something themselves.
+ */
+export function requireConsentGiven() {
+    const $ = window.$;
+
+    const pending = [
+        ['#accept-to-terms-and-conditions', 'the terms and conditions'],
+        ['#accept-to-privacy-policy', 'the privacy policy'],
+    ]
+        .filter(([selector]) => $(selector).length && !$(selector).prop('checked'))
+        .map(([, label]) => label);
+
+    if (pending.length) {
+        throw new Error(
+            `This booking cannot be submitted until the visitor themselves accepts ${pending.join(' and ')} on the ` +
+                'page. The form is filled in and waiting on the final step - ask them to tick the box and press ' +
+                'Confirm.',
+        );
+    }
+
+    if ($('.captcha-text').length || $('#altcha-payload').length) {
+        throw new Error(
+            'This booking form is protected by a captcha that only a person can complete. The form is filled in and ' +
+                'waiting on the final step - ask the visitor to solve it and press Confirm.',
+        );
+    }
+}
+
+/**
+ * Walk the wizard forward to its confirmation step, using its own navigation buttons.
+ *
+ * @return {Promise<void>}
+ */
+export async function advanceToConfirmation() {
+    const $ = window.$;
+
+    for (let step = 1; step <= 3; step++) {
+        if ($('#wizard-frame-4').is(':visible')) {
+            return;
+        }
+
+        const $frame = $(`#wizard-frame-${step}`);
+
+        if (!$frame.is(':visible')) {
+            continue;
+        }
+
+        $frame.find('.button-next').trigger('click');
+
+        try {
+            await waitFor(() => !$frame.is(':visible'), 'step did not advance', 2000);
+        } catch {
+            throw new Error(describeBlockedStep(step));
+        }
+    }
+
+    await waitFor(() => $('#wizard-frame-4').is(':visible'), 'The booking form never reached its confirmation step.');
+}
+
+/**
+ * Explain why the wizard refused to move on, using the page's own validation output.
+ *
+ * @param {Number} step Wizard step that refused.
+ *
+ * @return {String} Returns the message.
+ */
+function describeBlockedStep(step) {
+    const $ = window.$;
+
+    const invalid = $('.is-invalid')
+        .map((index, element) => $(`label[for="${element.id}"]`).text().trim() || element.id)
+        .get();
+
+    const formMessage = $('#form-message').text().trim();
+
+    if (invalid.length) {
+        return `The booking form rejected these details: ${invalid.join(', ')}.${formMessage ? ` ${formMessage}` : ''}`;
+    }
+
+    if (step === 2) {
+        return 'No appointment time is selected, so the booking form will not move on.';
+    }
+
+    return formMessage || `The booking form would not move past step ${step}.`;
+}
+
+/**
+ * Read the payload the wizard itself assembled for submission.
+ *
+ * @return {Object} Returns the decoded post data.
+ */
+export function readPostData() {
+    window.App.Pages.Booking.updateConfirmFrame();
+
+    const raw = window.$('input[name="post_data"]').val();
+
+    if (!raw) {
+        throw new Error('The booking form did not assemble any appointment data to submit.');
+    }
+
+    return JSON.parse(raw);
+}
+
+/**
+ * Submit the assembled booking to the site's own registration route.
+ *
+ * @param {Object} postData Payload the wizard assembled.
+ * @param {Number|null} [excludeAppointmentId] Appointment being rescheduled, if any.
+ *
+ * @return {Promise<Object>} Returns the site's response.
+ */
+export async function submitRegistration(postData, excludeAppointmentId = null) {
+    const payload = {post_data: postData};
+
+    if (excludeAppointmentId) {
+        payload.exclude_appointment_id = excludeAppointmentId;
+    }
+
+    const response = await postToSite('booking/register', payload);
+
+    if (response?.captcha_verification === false || response?.altcha_verification === false) {
+        throw new Error(
+            'The site rejected the booking because its captcha was not solved. Ask the visitor to complete it on ' +
+                'the page and press Confirm.',
+        );
+    }
+
+    if (!response?.appointment_hash) {
+        throw new Error('The site accepted the request but returned no appointment, so nothing was booked.');
+    }
+
+    return response;
+}
+
+/**
+ * The confirmation page URL for a booked appointment.
+ *
+ * @param {String} appointmentHash Appointment hash.
+ *
+ * @return {String} Returns the absolute URL.
+ */
+export function confirmationUrl(appointmentHash) {
+    return siteUrl(`booking_confirmation/of/${appointmentHash}`);
+}
+
+/**
+ * The timezone the booking form is currently displaying times in.
+ *
+ * @return {String} Returns the timezone identifier.
+ */
+export function selectedTimezone() {
+    return window.$('#select-timezone').val() || pageVar('default_timezone');
+}
