diff --git a/application/helpers/webmcp_helper.php b/application/helpers/webmcp_helper.php
new file mode 100644
index 0000000..4af3e3b
--- /dev/null
+++ b/application/helpers/webmcp_helper.php
@@ -0,0 +1,252 @@
+<?php defined('BASEPATH') or exit('No direct script access allowed');
+
+/* ----------------------------------------------------------------------------
+ * Easy!Appointments - Online Appointment Scheduler
+ *
+ * @package     EasyAppointments
+ * @author      A.Tselegidis <alextselegidis@gmail.com>
+ * @copyright   Copyright (c) Alex Tselegidis
+ * @license     https://opensource.org/licenses/GPL-3.0 - GPLv3
+ * @link        https://easyappointments.org
+ * ---------------------------------------------------------------------------- */
+
+/**
+ * WebMCP helper.
+ *
+ * Assembles the site's own visitor-facing content into flat, searchable sections. The `ask_site`
+ * WebMCP tool matches a visitor's question against these sections in the browser, so the site needs
+ * no search backend and no AI infrastructure of its own.
+ */
+
+if (!function_exists('webmcp_content_sections')) {
+    /**
+     * Build the visitor-facing content bundle.
+     *
+     * Every section is plain text with a human-readable source label, so the answer an agent composes
+     * can always be traced back to a page of this site.
+     *
+     * @return array Returns a list of ['id' => string, 'title' => string, 'source' => string, 'text' => string].
+     */
+    function webmcp_content_sections(): array
+    {
+        $CI = &get_instance();
+
+        $CI->load->model('services_model');
+        $CI->load->model('providers_model');
+
+        $company_name = setting('company_name');
+
+        $sections = [
+            [
+                'id' => 'business',
+                'title' => 'About ' . $company_name,
+                'source' => 'Booking page',
+                'text' => webmcp_join([
+                    $company_name . ' takes appointment bookings online through this site.',
+                    setting('company_email') ? 'Contact email: ' . setting('company_email') . '.' : null,
+                    setting('company_link') ? 'Website: ' . setting('company_link') . '.' : null,
+                    'Appointment times are shown in the ' . setting('default_timezone', 'UTC') . ' timezone by default.',
+                ]),
+            ],
+            [
+                'id' => 'opening-hours',
+                'title' => 'Opening hours',
+                'source' => 'Business settings',
+                'text' => webmcp_working_plan_text(setting('company_working_plan')),
+            ],
+            [
+                'id' => 'booking-rules',
+                'title' => 'Booking rules',
+                'source' => 'Booking settings',
+                'text' => webmcp_booking_rules_text(),
+            ],
+        ];
+
+        $available_services = $CI->services_model->get_available_services(true);
+
+        $service_names = array_column($available_services, 'name', 'id');
+
+        foreach ($available_services as $service) {
+            $price = (float) $service['price'];
+
+            $sections[] = [
+                'id' => 'service-' . $service['id'],
+                'title' => 'Service: ' . $service['name'],
+                'source' => 'Booking page, step 1',
+                'text' => webmcp_join([
+                    $service['name'] . ' lasts ' . $service['duration'] . ' minutes.',
+                    $price > 0
+                        ? 'It costs ' . number_format($price, 2) . ' ' . $service['currency'] . '.'
+                        : 'It is free of charge.',
+                    $service['description'] ?: null,
+                    $service['location'] ? 'Location: ' . $service['location'] . '.' : null,
+                    $service['service_category_name'] ? 'Category: ' . $service['service_category_name'] . '.' : null,
+                ]),
+            ];
+        }
+
+        foreach ($CI->providers_model->get_available_providers(true) as $provider) {
+            $offered = [];
+
+            foreach ($provider['services'] ?? [] as $service_id) {
+                if (isset($service_names[$service_id])) {
+                    $offered[] = $service_names[$service_id];
+                }
+            }
+
+            $full_name = trim($provider['first_name'] . ' ' . $provider['last_name']);
+
+            $sections[] = [
+                'id' => 'provider-' . $provider['id'],
+                'title' => 'Provider: ' . $full_name,
+                'source' => 'Booking page, step 1',
+                'text' => webmcp_join([
+                    $full_name . ' takes appointments at ' . $company_name . '.',
+                    $offered ? 'Services offered: ' . implode(', ', $offered) . '.' : null,
+                    'Their working timezone is ' . $provider['timezone'] . '.',
+                ]),
+            ];
+        }
+
+        $legal = [
+            ['terms', 'Terms and conditions', setting('display_terms_and_conditions'), 'terms_and_conditions_content'],
+            ['privacy', 'Privacy policy', setting('display_privacy_policy'), 'privacy_policy_content'],
+            ['cookies', 'Cookie notice', setting('display_cookie_notice'), 'cookie_notice_content'],
+        ];
+
+        foreach ($legal as [$id, $title, $displayed, $setting_key]) {
+            $content = webmcp_plain_text(setting($setting_key));
+
+            if ((string) $displayed !== '1' || $content === '') {
+                continue;
+            }
+
+            $sections[] = [
+                'id' => $id,
+                'title' => $title,
+                'source' => 'Booking page, ' . strtolower($title),
+                'text' => $content,
+            ];
+        }
+
+        $legal_links = webmcp_join([
+            setting('legal_notice_url') ? 'Legal notice: ' . setting('legal_notice_url') . '.' : null,
+            setting('imprint_url') ? 'Imprint: ' . setting('imprint_url') . '.' : null,
+        ]);
+
+        if ($legal_links !== '') {
+            $sections[] = [
+                'id' => 'legal-links',
+                'title' => 'Legal links',
+                'source' => 'Booking page footer',
+                'text' => $legal_links,
+            ];
+        }
+
+        return array_values(array_filter($sections, fn(array $section): bool => $section['text'] !== ''));
+    }
+}
+
+if (!function_exists('webmcp_working_plan_text')) {
+    /**
+     * Render the company working plan as a sentence per weekday.
+     *
+     * @param string|null $working_plan_json Working plan, as stored in the settings.
+     *
+     * @return string Returns the readable opening hours.
+     */
+    function webmcp_working_plan_text(?string $working_plan_json): string
+    {
+        $working_plan = json_decode((string) $working_plan_json, true);
+
+        if (!is_array($working_plan)) {
+            return '';
+        }
+
+        $lines = [];
+
+        foreach ($working_plan as $day => $hours) {
+            $label = ucfirst($day);
+
+            if (empty($hours['start']) || empty($hours['end'])) {
+                $lines[] = $label . ': closed.';
+                continue;
+            }
+
+            $line = $label . ': open from ' . $hours['start'] . ' to ' . $hours['end'];
+
+            $breaks = [];
+
+            foreach ($hours['breaks'] ?? [] as $break) {
+                if (!empty($break['start']) && !empty($break['end'])) {
+                    $breaks[] = $break['start'] . ' to ' . $break['end'];
+                }
+            }
+
+            $lines[] = $line . ($breaks ? ', with a break from ' . implode(' and ', $breaks) : '') . '.';
+        }
+
+        return webmcp_join(array_merge(['These are the opening hours for appointments.'], $lines));
+    }
+}
+
+if (!function_exists('webmcp_booking_rules_text')) {
+    /**
+     * Render the rules that govern when a visitor may book or change an appointment.
+     *
+     * @return string Returns the readable booking rules.
+     */
+    function webmcp_booking_rules_text(): string
+    {
+        $advance_timeout = (int) setting('book_advance_timeout');
+        $future_limit = (int) setting('future_booking_limit');
+
+        return webmcp_join([
+            $future_limit > 0 ? 'Appointments can be booked up to ' . $future_limit . ' days ahead.' : null,
+            $advance_timeout > 0
+                ? 'An appointment can no longer be changed or cancelled online within ' .
+                    $advance_timeout .
+                    ' minutes of its start time.'
+                : null,
+            (string) setting('display_any_provider') === '1'
+                ? 'A visitor may leave the choice of provider to the business.'
+                : 'A visitor must choose a specific provider when booking.',
+            (string) setting('require_captcha') === '1'
+                ? 'The booking form is protected by a captcha that the visitor completes themselves.'
+                : null,
+            (string) setting('disable_booking') === '1'
+                ? 'Online booking is currently switched off: ' . webmcp_plain_text(setting('disable_booking_message'))
+                : 'Online booking is currently open.',
+        ]);
+    }
+}
+
+if (!function_exists('webmcp_plain_text')) {
+    /**
+     * Reduce stored rich-text settings to plain, searchable text.
+     *
+     * @param string|null $html Stored content.
+     *
+     * @return string Returns the plain text equivalent.
+     */
+    function webmcp_plain_text(?string $html): string
+    {
+        $text = html_entity_decode(strip_tags((string) $html), ENT_QUOTES | ENT_HTML5, 'UTF-8');
+
+        return trim((string) preg_replace('/\s+/u', ' ', $text));
+    }
+}
+
+if (!function_exists('webmcp_join')) {
+    /**
+     * Join the non-empty parts of a section into one paragraph.
+     *
+     * @param array $parts Section parts, possibly containing nulls.
+     *
+     * @return string Returns the joined text.
+     */
+    function webmcp_join(array $parts): string
+    {
+        return trim(implode(' ', array_filter($parts, fn($part): bool => trim((string) $part) !== '')));
+    }
+}
diff --git a/application/views/components/webmcp_script.php b/application/views/components/webmcp_script.php
new file mode 100644
index 0000000..7e52897
--- /dev/null
+++ b/application/views/components/webmcp_script.php
@@ -0,0 +1,36 @@
+<?php
+/**
+ * WebMCP registration scripts.
+ *
+ * Publishes the site's own content bundle and loads the WebMCP entry module for this page scope, so a
+ * browser agent gets the site's tools instead of having to read the rendered page.
+ *
+ * The module URLs deliberately go through base_url() rather than asset_url(): asset_url() rewrites
+ * ".js" to ".min.js" outside debug mode, and these ES modules are shipped unminified (minifying them
+ * separately would break their relative imports).
+ *
+ * Local variables.
+ *
+ * @var string $entry Entry module name, without the "_entry.js" suffix.
+ */
+
+$webmcp_cache_busting_token = config('cache_busting_token');
+?>
+
+<script type="importmap">
+    {
+        "imports": {
+            "@nekuda/webmcp": "<?= base_url('vendor/nekuda-webmcp/dist/index.js') ?>"
+        }
+    }
+</script>
+
+<script>
+    window.__WEBMCP_SITE_CONTENT__ = <?= json_encode(
+        webmcp_content_sections(),
+        JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE,
+    ) ?>;
+</script>
+
+<script type="module"
+        src="<?= base_url('assets/js/webmcp/' . $entry . '_entry.js?' . $webmcp_cache_busting_token) ?>"></script>
