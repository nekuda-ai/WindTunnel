+                    }
+
+                    syncWizardSelection(service.id, resolved.id, startMoment.format('YYYY-MM-DD'));
+
+                    return textResult({
+                        ok: true,
+                        service: {id: Number(service.id), name: service.name, duration_minutes: Number(service.duration)},
+                        provider: resolved.provider
+                            ? {id: Number(resolved.provider.id), name: providerName(resolved.provider), timezone: resolved.provider.timezone}
+                            : 'any available provider',
+                        days: results,
