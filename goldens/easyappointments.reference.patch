+    }
+
+    // ------------------------------------------------------------------------
+    // cancel_appointment — lookup-keyed via the site's own emailed link token
+    // ------------------------------------------------------------------------
+
+    const confirmationMatch = window.location.pathname.match(/booking_confirmation\/of\/([a-zA-Z0-9]+)/);
+
+    const bakedHash = manageMode
+        ? vars('appointment_data').hash
+        : confirmationMatch
+          ? confirmationMatch[1]
+          : null;
+
+    if (onBookingWizard || bakedHash) {
+        const cancelProperties = {
+            reason: {type: 'string', description: 'Cancellation reason to record for the business (required by the site).'},
+        };
+
+        if (!bakedHash) {
+            cancelProperties.appointment_reference = {
+                type: 'string',
+                description: 'The appointment reference from the confirmation email/manage link (the token after "booking/reschedule/").',
+            };
+        }
+
+        modelContext.registerTool(
+            {
+                name: 'cancel_appointment',
+                description:
+                    (bakedHash
+                        ? 'PERMANENTLY cancels the appointment shown/confirmed on this page as soon as it is called — '
+                        : 'PERMANENTLY cancels an existing appointment as soon as it is called — ') +
+                    'only call after the user explicitly confirms. ' +
+                    (bakedHash
+                        ? ''
+                        : 'Requires the appointment_reference token from the customer\'s confirmation email (the site\'s own manage-link key); it cannot be guessed or looked up by email address. ') +
+                    'The appointment is first verified; if it exists and is still cancellable it is cancelled and ' +
+                    'the site\'s own cancellation confirmation screen is shown. The outcome is awaited, so a ' +
+                    'failed request is reported as a failure and nothing is changed. Cancellation is not reversible.',
+                inputSchema: {
+                    type: 'object',
+                    properties: cancelProperties,
+                    required: bakedHash ? ['reason'] : ['reason', 'appointment_reference'],
+                    additionalProperties: false,
+                },
+                annotations: {readOnlyHint: false},
+                execute: async (args) => {
+                    args = args || {};
+
+                    const hash = String(bakedHash || args.appointment_reference || '').trim();
+                    const reason = String(args.reason || '').trim();
+
+                    if (!hash || !/^[a-zA-Z0-9]+$/.test(hash)) {
+                        return errorResult('A valid appointment_reference token is required.');
+                    }
+
+                    if (!reason) {
+                        return errorResult('A non-empty cancellation reason is required by the site.');
+                    }
+
+                    // Verify the appointment exists and is still manageable (the site's
+                    // own manage page renders the cancel form only in that case).
+
+                    let manageHtml;
+
+                    try {
+                        const managePage = await fetch(siteUrl('booking/reschedule/' + hash), {credentials: 'same-origin'});
+                        manageHtml = await managePage.text();
+                    } catch (error) {
+                        return errorResult(`Could not verify the appointment: ${error.message}`);
+                    }
+
+                    if (!manageHtml.includes('cancel-appointment-frame')) {
+                        return errorResult(
+                            'No cancellable appointment found for this reference — it may already be cancelled, ' +
+                                'in the past, or inside the minimum-notice window.',
+                        );
+                    }
+
+                    // Submit the site's own cancellation form via fetch (the endpoint is
+                    // CSRF-exempt, exactly like the manage-page form) so the real outcome
+                    // is awaited before anything is reported. The endpoint deletes the
+                    // appointment and renders its result inline: the dedicated
+                    // "Appointment Cancelled" page on success, or the shared message page
+                    // (which carries #message-icon) for every failure — not found, rate
+                    // limited, or a server error.
+
+                    let cancelResponse;
+                    let cancelHtml;
+
+                    try {
+                        cancelResponse = await fetch(siteUrl('booking_cancellation/of/' + hash), {
+                            method: 'post',
+                            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
+                            body: new URLSearchParams({cancellation_reason: reason}).toString(),
+                            credentials: 'same-origin',
+                        });
+                        cancelHtml = await cancelResponse.text();
+                    } catch (error) {
+                        return errorResult(`The cancellation request failed and nothing was changed: ${error.message}`);
+                    }
+
+                    const cancelled = cancelResponse.ok && !cancelHtml.includes('id="message-icon"');
+
+                    if (!cancelled) {
+                        // The site returned its message/error page instead of the
+                        // cancellation confirmation, so the delete did not go through.
+                        return errorResult(
+                            'The site did not cancel the appointment — it may have just been cancelled, moved ' +
+                                'inside the minimum-notice window, or the request was rejected (e.g. too many ' +
+                                'attempts). Nothing was changed; check the appointment again before retrying.',
+                            {http_status: cancelResponse.status},
+                        );
+                    }
+
+                    // Confirmed deleted. Hand off to the site's own navigation exactly the
+                    // way book_appointment does — a clean window.location navigation instead
+                    // of re-injecting the fetched HTML with document.open/write/close, which
+                    // re-executes the confirmation page's scripts and raises unhandled promise
+                    // rejections. The awaited POST above already performed the delete and
+                    // returned the site's cancellation confirmation, so the outcome is known;
+                    // the page now returns to the booking screen in a clean load (the
+                    // post-delete cancellation view, unlike a booking confirmation, has no
+                    // persistent GET route to land on).
+                    setTimeout(() => {
+                        window.location.href = bookingPageUrl(); // Same navigation the site performs after cancellation.
+                    }, 800);
+
+                    return textResult({
+                        ok: true,
+                        status: 'appointment_cancelled',
+                        appointment_reference: hash,
+                        note:
+                            'The appointment has been cancelled and removed from the schedule — confirmed by the ' +
+                            "site's cancellation response. The page is navigating back to the booking screen. A " +
+                            'cancellation email is sent to the customer if the site has email notifications enabled.',
+                    });
+                },
+            },
+            {signal},
+        );
+    }
+})();
