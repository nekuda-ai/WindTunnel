+    }
+
+    // ------------------------------------------------------------------------
+    // Booking wizard page tools
+    // ------------------------------------------------------------------------
+
+    const onBookingWizard = Boolean(document.getElementById('book-appointment-wizard')) && $('#select-service').length > 0;
+    const manageMode = Boolean(vars('manage_mode'));
+
+    if (onBookingWizard && content.services.length) {
+        modelContext.registerTool(
+            {
+                name: 'check_availability',
+                description:
+                    'Read-only: fetch the real open appointment slots for a service on one or more days ' +
+                    '(same source as the visible calendar). Times are in the business-local time zone, 24h ' +
+                    '"HH:mm", and are directly bookable via book_appointment. The visible wizard calendar is ' +
+                    'updated to the queried service/provider/date so the user sees the same slots.',
+                inputSchema: {
+                    type: 'object',
+                    properties: {
+                        service_id: {
+                            type: ['integer', 'string'],
+                            description: 'Service id or exact name (see list_services). Defaults to the service selected in the wizard.',
+                        },
+                        provider_id: {
+                            type: ['integer', 'string'],
+                            description: 'Provider id or full name. Defaults to the wizard selection or the only provider of the service.',
+                        },
+                        date: {type: 'string', description: 'First day to check, "YYYY-MM-DD". Defaults to today.'},
+                        days: {type: 'integer', description: 'Number of consecutive days to check (1-7, default 1).'},
+                    },
+                    additionalProperties: false,
+                },
+                annotations: {readOnlyHint: true},
+                execute: async (args) => {
+                    args = args || {};
+
+                    const service = findService(args.service_id ?? $('#select-service').val());
+
+                    if (!service) {
+                        return errorResult('Unknown service. Call list_services for valid ids.', {
+                            services: content.services.map((entry) => ({id: Number(entry.id), name: entry.name})),
+                        });
+                    }
+
+                    const resolved = resolveProvider(service, args.provider_id);
+
+                    if (resolved.error) {
+                        return errorResult(resolved.error);
+                    }
+
+                    const startMoment = args.date ? moment(args.date, 'YYYY-MM-DD', true) : moment();
+
+                    if (!startMoment.isValid()) {
+                        return errorResult('Invalid "date" — use the "YYYY-MM-DD" format.');
+                    }
+
+                    const days = Math.min(Math.max(Number(args.days) || 1, 1), 7);
+                    const results = [];
+
+                    for (let offset = 0; offset < days; offset++) {
+                        const date = startMoment.clone().add(offset, 'days').format('YYYY-MM-DD');
+
+                        try {
+                            const hours = await fetchAvailableHours(service.id, resolved.id, date);
+                            results.push({date: date, open_slots: hours});
+                        } catch (error) {
+                            results.push({date: date, error: error.message});
