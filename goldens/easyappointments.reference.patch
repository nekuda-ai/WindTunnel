diff --git a/application/helpers/webmcp_helper.php b/application/helpers/webmcp_helper.php
new file mode 100644
index 00000000..13d419ab
--- /dev/null
+++ b/application/helpers/webmcp_helper.php
@@ -0,0 +1,76 @@
+<?php defined('BASEPATH') or exit('No direct script access allowed');
+
+/* ----------------------------------------------------------------------------
+ * Easy!Appointments - WebMCP reference implementation
+ *
+ * Exposes a compact, whole-site content bundle to the WebMCP page module
+ * (assets/js/webmcp/webmcp.js) via script vars. Public layouts call
+ * webmcp_script_vars() right before the "js_vars_script" component renders,
+ * so the bundle rides the same window.vars() channel the app already uses.
+ *
+ * The bundle only contains data the site already shows or enforces publicly:
+ * bookable services, public provider info, business hours, booking policies
+ * and the configured legal documents. No credentials or private records.
+ * ---------------------------------------------------------------------------- */
+
+if (!function_exists('webmcp_script_vars')) {
+    /**
+     * Register the WebMCP content bundle as script vars for the current page.
+     */
+    function webmcp_script_vars(): void
+    {
+        if (!is_app_installed()) {
+            return; // Nothing to expose while the app is not installed yet.
+        }
+
+        /** @var EA_Controller $CI */
+        $CI = &get_instance();
+
+        $CI->load->model('services_model');
+        $CI->load->model('providers_model');
+
+        $services = $CI->services_model->get_available_services(true);
+
+        $service_fields = ['id', 'name', 'duration', 'price', 'currency', 'description', 'location'];
+
+        foreach ($services as &$service) {
+            $CI->services_model->only($service, $service_fields);
+        }
+
+        $providers = $CI->providers_model->get_available_providers(true);
+
+        $provider_fields = ['id', 'first_name', 'last_name', 'services', 'timezone'];
+
+        foreach ($providers as &$provider) {
+            $CI->providers_model->only($provider, $provider_fields);
+        }
+
+        $legal = [];
+
+        if (setting('display_terms_and_conditions') === '1') {
+            $legal['terms_and_conditions'] = trim(strip_tags((string) setting('terms_and_conditions_content')));
+        }
+
+        if (setting('display_privacy_policy') === '1') {
+            $legal['privacy_policy'] = trim(strip_tags((string) setting('privacy_policy_content')));
+        }
+
+        script_vars([
+            'webmcp_content' => [
+                'company' => [
+                    'name' => setting('company_name'),
+                    'email' => setting('company_email'),
+                    'link' => setting('company_link'),
+                ],
+                'services' => $services,
+                'providers' => filter_sensitive_users_data($providers),
+                'working_plan' => json_decode((string) setting('company_working_plan'), true),
+                'booking_policies' => [
+                    'book_advance_timeout_minutes' => (int) setting('book_advance_timeout'),
+                    'future_booking_limit_days' => (int) setting('future_booking_limit'),
+                ],
+                'legal' => $legal,
+            ],
+        ]);
+    }
+}
