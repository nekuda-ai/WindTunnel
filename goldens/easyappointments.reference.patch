+                    });
+                },
+            },
+            {signal},
+        );
+
+        // Customer-detail params mirror the wizard's own contact form: only the
+        // fields the site displays become params, and the fields the site marks
+        // required become required — page state shapes the registration.
+        const CUSTOMER_FIELDS = [
+            {id: 'first-name', param: 'first_name', description: 'Customer first name.'},
+            {id: 'last-name', param: 'last_name', description: 'Customer last name.'},
+            {id: 'email', param: 'email', description: 'Customer email — receives the confirmation and manage link.'},
+            {id: 'phone-number', param: 'phone_number', description: 'Customer phone number.'},
+            {id: 'address', param: 'address', description: 'Customer street address.'},
+            {id: 'city', param: 'city', description: 'Customer city.'},
+            {id: 'zip-code', param: 'zip_code', description: 'Customer zip code.'},
+            {id: 'notes', param: 'notes', description: 'Optional notes for the business.'},
+        ].filter((field) => document.getElementById(field.id));
+
+        const requiredCustomerParams = manageMode
+            ? [] // Manage mode: contact details are prefilled from the loaded appointment.
+            : CUSTOMER_FIELDS.filter((field) => document.getElementById(field.id).classList.contains('required')).map(
+                  (field) => field.param,
+              );
+
+        const customerProperties = {};
+
+        CUSTOMER_FIELDS.forEach((field) => {
+            customerProperties[field.param] = {type: 'string', description: field.description};
+        });
+
+        modelContext.registerTool(
+            {
+                name: 'book_appointment',
+                description: manageMode
+                    ? 'RESCHEDULES the existing appointment loaded on this page to a new date/time — this changes ' +
+                      'a real booking as soon as it is called. Pick a slot from check_availability first. The page ' +
+                      'then navigates to the confirmation screen. Contact details stay as loaded unless overridden.'
+                    : 'CREATES a real appointment at this business as soon as it is called — do not call until the ' +
+                      'user has confirmed service, time and contact details. Requires an open slot from ' +
+                      'check_availability ("date" + business-local "time"). On success the visible wizard reflects ' +
+                      'the selection, the page navigates to the booking confirmation screen, and the response ' +
+                      'includes the appointment id plus the personal manage/cancel link (which the site also emails ' +
+                      'to the customer when email notifications are enabled). If the slot was just taken, the ' +
+                      'response lists the remaining open slots.',
+                inputSchema: {
+                    type: 'object',
+                    properties: Object.assign(
+                        {
+                            service_id: {
+                                type: ['integer', 'string'],
+                                description: manageMode
+                                    ? 'Service id or name — defaults to the service of the loaded appointment.'
+                                    : 'Service id or exact name (see list_services).',
+                            },
+                            provider_id: {
+                                type: ['integer', 'string'],
+                                description: 'Provider id or full name. Defaults to the only/selected provider of the service.',
+                            },
+                            date: {type: 'string', description: 'Appointment day, "YYYY-MM-DD".'},
+                            time: {type: 'string', description: 'Start time from check_availability, business-local 24h "HH:mm".'},
+                        },
+                        customerProperties,
+                    ),
+                    required: ['date', 'time'].concat(requiredCustomerParams),
+                    additionalProperties: false,
+                },
+                annotations: {readOnlyHint: false},
+                execute: async (args) => {
+                    args = args || {};
+
+                    if ($('.captcha-text').length || $('#altcha-widget').length) {
+                        return errorResult(
+                            'This site requires a human verification (CAPTCHA) step — ask the user to press ' +
+                                '"Book Appointment" in the page after completing it.',
+                        );
+                    }
+
+                    const service = findService(args.service_id ?? $('#select-service').val());
+
+                    if (!service) {
+                        return errorResult('Unknown service. Call list_services for valid ids.', {
+                            services: content.services.map((entry) => ({id: Number(entry.id), name: entry.name})),
+                        });
+                    }
+
+                    const resolved = resolveProvider(service, args.provider_id);
+
+                    if (resolved.error) {
+                        return errorResult(resolved.error);
+                    }
+
+                    const dateMoment = moment(String(args.date), 'YYYY-MM-DD', true);
+                    const timeMoment = moment(String(args.time), 'HH:mm', true);
+
+                    if (!dateMoment.isValid() || !timeMoment.isValid()) {
+                        return errorResult('Use "YYYY-MM-DD" for date and business-local 24h "HH:mm" for time.');
+                    }
+
+                    const date = dateMoment.format('YYYY-MM-DD');
+                    const time = timeMoment.format('HH:mm');
+
+                    // Honest availability check through the wizard's own endpoint.
+
+                    let openSlots;
+
+                    try {
+                        openSlots = await fetchAvailableHours(service.id, resolved.id, date);
+                    } catch (error) {
+                        return errorResult(`Could not verify availability: ${error.message}`);
+                    }
+
+                    if (!openSlots.includes(time)) {
+                        return errorResult(`${date} ${time} is not an open slot.`, {
+                            date: date,
+                            open_slots: openSlots,
+                            note: openSlots.length
+                                ? 'Pick one of the open slots and call book_appointment again.'
+                                : 'No open slots that day — use check_availability on other days.',
+                        });
+                    }
+
+                    // Drive the visible wizard: selection, calendar, slot, contact form.
+
+                    syncWizardSelection(service.id, resolved.id, date);
+
+                    let $slot;
+
+                    try {
+                        $slot = await waitFor(() => {
+                            const $match = $('#available-hours .available-hour').filter(
+                                (index, element) => String($(element).data('value')) === time,
+                            );
+                            return $match.length ? $match : null;
+                        });
+                    } catch (error) {
+                        return errorResult('The booking calendar did not load the requested slot — try again.');
+                    }
+
+                    $slot.trigger('click'); // Site handler marks it selected + updates the summary.
+
+                    CUSTOMER_FIELDS.forEach((field) => {
+                        if (args[field.param] !== undefined) {
+                            $('#' + field.id).val(String(args[field.param]));
+                        }
+                    });
+
+                    if (!App.Pages.Booking.validateCustomerForm()) {
+                        const missing = $('#wizard-frame-3 .is-invalid')
+                            .map((index, element) => element.id)
+                            .get();
+                        return errorResult('Customer details failed the site validation.', {
+                            invalid_fields: missing,
+                            note: 'Provide valid values for these fields (shown highlighted in the page).',
+                        });
+                    }
+
+                    App.Pages.Booking.updateConfirmFrame(); // Builds the wizard's own post_data payload.
+
+                    const postData = JSON.parse($('input[name="post_data"]').val());
+
+                    const requestData = {
+                        csrf_token: vars('csrf_token'),
+                        post_data: postData,
+                    };
+
+                    if (manageMode) {
+                        requestData.exclude_appointment_id = vars('appointment_data').id;
+                    }
+
+                    let response;
+
+                    try {
+                        response = await postForm('booking/register', requestData);
+                    } catch (error) {
+                        return errorResult(`The site rejected the booking: ${error.message}`);
+                    }
+
+                    const confirmationUrl = siteUrl('booking_confirmation/of/' + response.appointment_hash);
+                    const manageUrl = siteUrl('booking/reschedule/' + response.appointment_hash);
+
+                    setTimeout(() => {
+                        window.location.href = confirmationUrl; // Same navigation the wizard performs.
+                    }, 800);
+
+                    return textResult({
+                        ok: true,
+                        status: manageMode ? 'appointment_rescheduled' : 'appointment_booked',
+                        appointment_id: response.appointment_id,
+                        appointment_reference: response.appointment_hash,
+                        service: service.name,
+                        provider: resolved.provider ? providerName(resolved.provider) : 'assigned automatically',
+                        start: `${date} ${time}`,
+                        duration_minutes: Number(service.duration),
+                        manage_link: manageUrl,
+                        note:
+                            'The booking is confirmed and saved — the site returned this appointment id and ' +
+                            'reference. The page is navigating to the booking confirmation screen. A confirmation ' +
