diff --git a/assets/js/webmcp/webmcp.js b/assets/js/webmcp/webmcp.js
new file mode 100644
index 00000000..fcc299a4
--- /dev/null
+++ b/assets/js/webmcp/webmcp.js
@@ -0,0 +1,985 @@
+/* ----------------------------------------------------------------------------
+ * Easy!Appointments - WebMCP reference implementation
+ *
+ * Registers page-appropriate WebMCP tools (document.modelContext.registerTool)
+ * so a browser agent can answer visitor questions and complete the booking
+ * journey through the site's own logic, while the visible booking wizard
+ * stays in sync with everything the agent does.
+ *
+ * Registration map (per page document — navigation drops and re-registers):
+ * - Every page carrying the content bundle (booking, confirmation/message,
+ *   login, and the back office): ask_site, list_services (read-only, fed by
+ *   the server-injected "webmcp_content" bundle — see
+ *   application/helpers/webmcp_helper.php).
+ * - Signed out: sign_in. Signed in (back office): list_customers. A successful
+ *   sign_in registers the back-office tools in place, so an agent that can
+ *   only call tools is never stranded at the login wall with nothing to call.
+ * - Booking wizard page: check_availability, book_appointment,
+ *   cancel_appointment. In manage mode (emailed appointment link) the
+ *   book_appointment registration becomes "reschedule this appointment"
+ *   and cancel_appointment bakes in the loaded appointment.
+ * - Booking confirmation page: cancel_appointment baked to the appointment
+ *   hash in the URL.
+ *
+ * Feature-detects the WebMCP API and no-ops when it is absent.
+ * ---------------------------------------------------------------------------- */
+
+(function () {
+    'use strict';
+
+    const modelContext = document.modelContext ?? navigator.modelContext;
+
+    if (!modelContext || typeof modelContext.registerTool !== 'function') {
+        return; // WebMCP not available in this browser.
+    }
+
+    const content = window.vars ? vars('webmcp_content') : undefined;
+
+    if (!content) {
+        return; // Not a public content page (e.g. app not installed yet).
+    }
+
+    const abortController = new AbortController();
+    const signal = abortController.signal;
+
+    const WEEKDAYS = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
+
+    function siteUrl(uri) {
+        return App.Utils.Url.siteUrl(uri);
+    }
+
+    function bookingPageUrl() {
+        return vars('base_url');
+    }
+
+    function textResult(payload) {
+        return {content: [{type: 'text', text: JSON.stringify(payload, null, 2)}]};
+    }
+
+    function errorResult(message, extra) {
+        return textResult(Object.assign({ok: false, error: message}, extra || {}));
+    }
+
+    function findService(serviceRef) {
+        return content.services.find(
+            (service) =>
+                Number(service.id) === Number(serviceRef) ||
+                String(service.name).toLowerCase() === String(serviceRef).toLowerCase().trim(),
+        );
+    }
+
+    function providersForService(serviceId) {
+        return content.providers.filter((provider) =>
+            provider.services.some((providerServiceId) => Number(providerServiceId) === Number(serviceId)),
+        );
+    }
+
+    function providerName(provider) {
+        return `${provider.first_name} ${provider.last_name}`.trim();
+    }
+
+    function serviceSummary(service) {
+        return {
+            id: Number(service.id),
+            name: service.name,
+            duration_minutes: Number(service.duration),
+            price: Number(service.price) > 0 ? `${Number(service.price).toFixed(2)} ${service.currency}`.trim() : 'free',
+            location: service.location || null,
+            description: service.description || null,
+            providers: providersForService(service.id).map((provider) => ({
+                id: Number(provider.id),
+                name: providerName(provider),
+            })),
+        };
+    }
+
+    function workingPlanReadable() {
+        const plan = content.working_plan || {};
+
+        return WEEKDAYS.map((day) => {
+            const dayPlan = plan[day];
+
+            if (!dayPlan) {
+                return `${day}: closed`;
+            }
+
+            const breaks = (dayPlan.breaks || [])
+                .map((dayBreak) => `${dayBreak.start}-${dayBreak.end}`)
+                .join(', ');
+
+            return `${day}: ${dayPlan.start}-${dayPlan.end}` + (breaks ? ` (break ${breaks})` : '');
+        });
+    }
+
+    /**
+     * Poll until the callback returns a truthy value (used to wait for the
+     * wizard's own async renders — the tool drives the page, never bypasses it).
+     */
+    function waitFor(callback, timeout = 8000, interval = 150) {
+        return new Promise((resolve, reject) => {
+            const start = Date.now();
+
+            const timer = setInterval(() => {
+                const result = callback();
+
+                if (result) {
+                    clearInterval(timer);
+                    resolve(result);
+                    return;
+                }
+
+                if (Date.now() - start > timeout) {
+                    clearInterval(timer);
+                    reject(new Error('Timed out while waiting for the page to update.'));
+                }
+            }, interval);
+        });
+    }
+
+    function postForm(uri, data) {
+        return new Promise((resolve, reject) => {
+            $.ajax({url: siteUrl(uri), method: 'post', data: data, dataType: 'json', global: false})
+                .done(resolve)
+                .fail((jqXHR) => {
+                    let message;
+
+                    try {
+                        message = JSON.parse(jqXHR.responseText).message;
+                    } catch (error) {
+                        message = jqXHR.responseText || 'Request failed';
+                    }
+
+                    reject(new Error(message));
+                });
+        });
+    }
+
+    /**
+     * Fetch the real open slots for a service/provider/date through the
+     * booking wizard's own endpoint (times are business-local, "HH:mm").
+     */
+    function fetchAvailableHours(serviceId, providerId, date) {
+        const service = findService(serviceId);
+
+        return postForm('booking/get_available_hours', {
+            csrf_token: vars('csrf_token'),
+            service_id: serviceId,
+            provider_id: providerId,
+            selected_date: date,
+            service_duration: service ? service.duration : 15,
+            manage_mode: Number(vars('manage_mode') || 0),
+            appointment_id: vars('manage_mode') ? vars('appointment_data').id : null,
+        });
+    }
+
+    /**
+     * Resolve the provider to use for a service: explicit argument, current
+     * wizard selection, the only provider that serves the service, or the
+     * site's own "any provider" option when enabled.
+     */
+    function resolveProvider(service, providerRef) {
+        const candidates = providersForService(service.id);
+
+        if (providerRef !== undefined && providerRef !== null && providerRef !== '') {
+            const provider = candidates.find(
+                (candidate) =>
+                    Number(candidate.id) === Number(providerRef) ||
+                    providerName(candidate).toLowerCase() === String(providerRef).toLowerCase().trim(),
+            );
+
+            return provider
+                ? {id: String(provider.id), provider: provider}
+                : {
+                      error:
+                          `Provider "${providerRef}" does not offer "${service.name}". ` +
+                          `Available providers: ${candidates.map((candidate) => `${candidate.id} (${providerName(candidate)})`).join(', ')}`,
+                  };
+        }
+
+        const $selectProvider = $('#select-provider');
+        const selectedProviderId = $selectProvider.length ? $selectProvider.val() : null;
+
+        if (
+            selectedProviderId &&
+            selectedProviderId !== 'any-provider' &&
+            candidates.some((candidate) => Number(candidate.id) === Number(selectedProviderId))
+        ) {
+            const provider = candidates.find((candidate) => Number(candidate.id) === Number(selectedProviderId));
+            return {id: String(provider.id), provider: provider};
+        }
+
+        if (candidates.length === 1) {
+            return {id: String(candidates[0].id), provider: candidates[0]};
+        }
+
+        if (Boolean(Number(vars('display_any_provider')))) {
+            return {id: 'any-provider', provider: null};
+        }
+
+        return {
+            error:
+                `Multiple providers offer "${service.name}" — pass provider_id. ` +
+                `Options: ${candidates.map((candidate) => `${candidate.id} (${providerName(candidate)})`).join(', ')}`,
+        };
+    }
+
+    /**
+     * Reflect a service/provider/date selection in the visible booking wizard,
+     * using the wizard's own handlers (select change events, flatpickr, the
+     * page's own available-hours fetch + render).
+     */
+    function syncWizardSelection(serviceId, providerId, date) {
+        const $selectService = $('#select-service');
+        const $selectProvider = $('#select-provider');
+        const $selectDate = $('#select-date');
+
+        if (String($selectService.val()) !== String(serviceId)) {
+            $selectService.val(String(serviceId)).trigger('change');
+        }
+
+        if (String($selectProvider.val()) !== String(providerId)) {
+            $selectProvider.val(String(providerId)).trigger('change');
+        }
+
+        // The wizard's datepicker expects a Date object (its own handlers pass moment().toDate()).
+        App.Utils.UI.setDateTimePickerValue($selectDate, moment(date, 'YYYY-MM-DD').toDate());
+        App.Http.Booking.getAvailableHours(date); // Site's own renderer fills #available-hours.
+    }
+
+    // ------------------------------------------------------------------------
+    // ask_site — universal, read-only retrieval over the site's own content
+    // ------------------------------------------------------------------------
+
+    function buildSections() {
+        const bookingUrl = bookingPageUrl();
+        const sections = [];
+
+        content.services.forEach((service) => {
+            const summary = serviceSummary(service);
+            sections.push({
+                title: `Service: ${service.name}`,
+                text:
+                    `${service.name} — ${summary.duration_minutes} minutes, ${summary.price}.` +
+                    (service.location ? ` Location: ${service.location}.` : '') +
+                    (service.description ? ` ${service.description}` : '') +
+                    ` Offered by: ${summary.providers.map((provider) => provider.name).join(', ') || 'no provider yet'}.`,
+                source: bookingUrl,
+                keywords: 'service services offer offerings treatment book price cost duration long',
+            });
+        });
+
+        content.providers.forEach((provider) => {
+            const services = content.services
+                .filter((service) => provider.services.some((id) => Number(id) === Number(service.id)))
+                .map((service) => service.name);
+            sections.push({
+                title: `Provider: ${providerName(provider)}`,
+                text: `${providerName(provider)} provides: ${services.join(', ') || 'no services yet'}. Time zone: ${provider.timezone}.`,
+                source: bookingUrl,
+                keywords: 'provider staff who specialist person team member',
+            });
+        });
+
+        sections.push({
+            title: 'Business hours',
+            text: `Weekly working hours (business-local time): ${workingPlanReadable().join('; ')}.`,
+            source: bookingUrl,
+            keywords: 'hours open opening closed schedule when time working days weekend',
+        });
+
+        sections.push({
+            title: 'Booking policies',
+            text:
+                `Appointments must be booked, rescheduled or cancelled at least ` +
+                `${content.booking_policies.book_advance_timeout_minutes} minutes before the start time, ` +
+                `and can be booked up to ${content.booking_policies.future_booking_limit_days} days in advance. ` +
+                `Each confirmation email contains a personal appointment link used to reschedule or cancel.`,
+            source: bookingUrl,
+            keywords: 'policy policies cancel cancellation reschedule change appointment rules notice how far advance',
+        });
+
+        sections.push({
+            title: `About ${content.company.name}`,
+            text: `${content.company.name} — online appointment scheduling. Email: ${content.company.email}. Website: ${content.company.link}.`,
+            source: bookingUrl,
+            keywords: 'contact email company about who website phone reach',
+        });
+
+        if (content.legal.terms_and_conditions) {
+            sections.push({
+                title: 'Terms & conditions',
+                text: content.legal.terms_and_conditions,
+                source: bookingUrl,
+                keywords: 'terms conditions legal agreement',
+            });
+        }
+
+        if (content.legal.privacy_policy) {
+            sections.push({
+                title: 'Privacy policy',
+                text: content.legal.privacy_policy,
+                source: bookingUrl,
+                keywords: 'privacy policy data personal information gdpr',
+            });
+        }
+
+        return sections;
+    }
+
+    const STOPWORDS = new Set([
+        'the', 'and', 'you', 'your', 'yours', 'for', 'can', 'could', 'how', 'what', 'when', 'who', 'where',
+        'which', 'why', 'are', 'does', 'did', 'with', 'have', 'has', 'had', 'this', 'that', 'there', 'they',
+        'will', 'would', 'should', 'may', 'might', 'must', 'about', 'any', 'some', 'get', 'need', 'want',
+        'tell', 'know', 'take', 'much', 'many', 'more', 'from', 'into', 'not', 'but', 'all', 'was', 'were',
+        'been', 'being', 'also', 'just', 'like', 'please', 'appointment', 'appointments',
+    ]);
+
+    function askSite(args) {
+        const query = String(args.query || '').toLowerCase();
+
+        if (!query.trim()) {
+            return errorResult('Provide a non-empty "query".');
+        }
+
+        const terms = query.split(/[^a-z0-9]+/).filter((term) => term.length > 2 && !STOPWORDS.has(term));
+        const sections = buildSections();
+
+        const scored = sections
+            .map((section) => {
+                const haystack = `${section.title} ${section.text} ${section.keywords}`.toLowerCase();
+                const score = terms.reduce((sum, term) => {
+                    const stem = term.endsWith('s') ? term.slice(0, -1) : term;
+                    return sum + (haystack.includes(term) || haystack.includes(stem) ? 1 : 0);
+                }, 0);
+                return {section, score};
+            })
+            .filter((entry) => entry.score > 0)
+            .sort((a, b) => b.score - a.score)
+            .slice(0, 4);
+
+        return textResult({
+            ok: true,
+            query: args.query,
+            results: scored.map((entry) => ({
+                title: entry.section.title,
+                content: entry.section.text,
+                source: entry.section.source,
+            })),
+            note: scored.length
+                ? 'Compose the answer from these site content sections.'
+                : 'No matching site content — tell the user the site does not cover this topic.',
+        });
+    }
+
+    // ------------------------------------------------------------------------
+    // Registrations
+    // ------------------------------------------------------------------------
+
+    modelContext.registerTool(
+        {
+            name: 'ask_site',
+            description:
+                `Read-only: answer questions about ${content.company.name} from the site's own content — ` +
+                'offered services (with prices and durations), providers, business hours, booking/cancellation ' +
+                'policies and contact details. Returns matching content sections plus source URLs; compose the ' +
+                'answer from them. Use for any "what/when/who/how" question about this business.',
+            inputSchema: {
+                type: 'object',
+                properties: {
+                    query: {type: 'string', description: 'The visitor question, in natural language.'},
+                },
+                required: ['query'],
+                additionalProperties: false,
+            },
+            annotations: {readOnlyHint: true},
+            execute: async (args) => askSite(args || {}),
+        },
+        {signal},
+    );
+
+    modelContext.registerTool(
+        {
+            name: 'list_services',
+            description:
+                'Read-only: list every bookable service with id, duration, price, location, description and the ' +
+                'providers who offer it. Use the returned service id (and provider id) with check_availability ' +
+                'and book_appointment.',
+            inputSchema: {type: 'object', properties: {}, additionalProperties: false},
+            annotations: {readOnlyHint: true},
+            execute: async () =>
+                textResult({
+                    ok: true,
+                    services: content.services.map(serviceSummary),
+                    booking_page: bookingPageUrl(),
+                }),
+        },
+        {signal},
+    );
+
+    // ------------------------------------------------------------------------
+    // Back office: sign-in and the tools it unlocks
+    //
+    // The back office is only reachable with a session, and an agent working
+    // through WebMCP has no login form it may touch — so signed out we expose
+    // sign_in, and nothing else from this section. On success it registers the
+    // back-office tools straight away rather than navigating: the endpoints are
+    // session-cookie authenticated and work from whichever page the agent is
+    // on, so a page load would cost a round trip and buy nothing.
+    //
+    // A direct visit to a back-office page (backend_layout) is already signed
+    // in, so the same tools register up front there.
+    // ------------------------------------------------------------------------
+
+    const signedIn = Boolean(window.vars && vars('user_id'));
+
+    function customerSummary(customer) {
+        return {
+            id: customer.id,
+            first_name: customer.first_name,
+            last_name: customer.last_name,
+            email: customer.email,
+            phone_number: customer.phone_number,
+        };
+    }
+
+    function registerBackOfficeTools() {
+        modelContext.registerTool(
+            {
+                name: 'list_customers',
+                description:
+                    'Read-only: list the customer records held in the back office — name, email and phone for ' +
+                    'each. Optionally narrow with a keyword (matched against name, email and phone). Requires a ' +
+                    'signed-in session: call sign_in first if it reports you are not signed in.',
+                inputSchema: {
+                    type: 'object',
+                    properties: {
+                        keyword: {type: 'string', description: 'Optional search term; omit to list all customers.'},
+                        limit: {type: 'number', description: 'Maximum records to return. Default 100.'},
+                    },
+                    additionalProperties: false,
+                },
+                annotations: {readOnlyHint: true},
+                execute: async (args) => {
+                    const {keyword = '', limit = 100} = args || {};
+
+                    let customers;
+
+                    try {
+                        customers = await postForm('customers/search', {
+                            csrf_token: vars('csrf_token'),
+                            keyword: keyword,
+                            limit: limit,
+                            offset: 0,
+                        });
+                    } catch (error) {
+                        // The endpoint aborts 403 without the customers privilege,
+                        // which for an agent almost always means "no session yet".
+                        return errorResult(
+                            `Could not read customers: ${error.message}. If you have not signed in yet, call ` +
+                                'sign_in with the account credentials and try again.',
+                        );
+                    }
+
+                    const rows = Array.isArray(customers) ? customers : [];
+
+                    return textResult({
