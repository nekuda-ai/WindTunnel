+// WebMCP core helpers (webmachinelearning/webmcp draft).
+// Feature-detects document.modelContext / navigator.modelContext and no-ops
+// when the browser doesn't expose the API.
+
+export interface WebMCPToolDefinition {
+  name: string
+  description: string
+  inputSchema: Record<string, unknown>
+  annotations?: { readOnlyHint?: boolean }
+  execute: (_args: any) => Promise<{ content: Array<{ type: 'text'; text: string }> }>
+}
+
+export function getModelContext(): any | null {
+  if (typeof document === 'undefined') return null
+  return (
+    (document as any).modelContext ??
+    (typeof navigator !== 'undefined' ? (navigator as any).modelContext : null) ??
+    null
+  )
+}
+
+// MCP-style content block from a structured payload.
+export function mcpJson(payload: unknown) {
+  return { content: [{ type: 'text' as const, text: JSON.stringify(payload) }] }
+}
+
+// Register a set of tools bound to one AbortSignal (abort = unregister all).
+// Duplicate names throw in the native implementation — warn, never crash the app.
+export function registerWebMCPTools(
+  tools: WebMCPToolDefinition[],
+  signal: AbortSignal
+): void {
+  const mc = getModelContext()
+  if (!mc?.registerTool || signal.aborted) return
+  for (const tool of tools) {
+    try {
+      mc.registerTool(tool, { signal })
+    } catch (err) {
+      console.warn(`[webmcp] failed to register ${tool.name}:`, err)
+    }
+  }
+}
