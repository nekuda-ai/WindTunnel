+import { NextResponse } from "next/server";
+import { getAllBookmarks, getAllCategories } from "@/lib/data";
+import { directory } from "@/directory.config";
+
+// Public read-only snapshot of the directory, consumed by the WebMCP tools
+// (components/webmcp-tools.tsx). Same data the homepage renders: every
+// bookmark joined with its category, plus the category list.
+export async function GET() {
+  try {
+    const [bookmarks, categories] = await Promise.all([
+      getAllBookmarks(),
+      getAllCategories(),
+    ]);
+
+    return NextResponse.json({
+      site: { name: directory.name, description: directory.description },
+      categories: categories.map((category) => ({
+        id: category.id,
+        name: category.name,
+        slug: category.slug,
+        description: category.description,
+      })),
+      bookmarks: bookmarks.map((bookmark) => ({
+        id: bookmark.id,
+        slug: bookmark.slug,
+        title: bookmark.title,
+        description: bookmark.description,
+        url: bookmark.url,
+        overview: bookmark.overview,
+        tags: bookmark.tags,
+        notes: bookmark.notes,
+        isFavorite: bookmark.isFavorite,
+        category: bookmark.category
+          ? { id: bookmark.category.id, name: bookmark.category.name }
+          : null,
+      })),
+    });
+  } catch (error) {
+    console.error("Error fetching directory data:", error);
+    return NextResponse.json(
+      { error: "Failed to fetch directory data" },
+      { status: 500 },
+    );
+  }
+}
