# ?sslmode=disable is load-bearing: with a non-localhost host ("db") Medusa defaults the
# migrator/module DB connection to SSL, which the local Postgres rejects, and db:migrate then
# retries the failed connection forever (0 migrations). The flag forces a plain connection.
DATABASE_URL=postgres://medusa:medusa@db:5432/medusa?sslmode=disable
STORE_CORS={{BASE_URL}}
ADMIN_CORS=http://backend:9000
AUTH_CORS={{BASE_URL}},http://backend:9000
JWT_SECRET=webmcp-evaluator-jwt-secret
COOKIE_SECRET=webmcp-evaluator-cookie-secret
NODE_ENV=development
